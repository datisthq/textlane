from typing import Optional

class TextlaneError(Exception):
    code: str

class Pipeline:
    def __init__(self) -> None: ...
    def use(self, value: str, options: Optional[str] = None) -> None: ...
    def data(self, key: Optional[str] = None) -> str: ...
    def set_data(self, key: str, value: str) -> None: ...
    def replace_data(self, data: str) -> None: ...
    def freeze(self) -> None: ...
    def parse(self, text: str) -> str: ...
    def run(self, tree: str, value: Optional[str] = None) -> str: ...
    def run_sync(self, tree: str, value: Optional[str] = None) -> str: ...
    def stringify(self, tree: str) -> str: ...
    def process(self, text: str) -> str: ...
    def process_sync(self, text: str) -> str: ...
    def hosts(self) -> list[int]: ...
    def start_run(self, tree: str, value: Optional[str], sync: bool) -> Run: ...
    def start_process(self, text: str, sync: bool) -> Run: ...

class Run:
    def hosts(self) -> list[int]: ...
    def tree(self) -> str: ...
    def value(self) -> Optional[str]: ...
    def messages(self) -> str: ...
    def resume(self, tree: str, messages: str) -> None: ...
    def result(self) -> str: ...

def version() -> str: ...
def plugin_names() -> list[str]: ...
def retained_memory() -> int: ...
def set_retained_memory(bytes: int) -> None: ...
def run_case(case: str) -> str: ...
