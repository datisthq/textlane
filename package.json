{
  "name": "textlane-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -C rust build && pnpm -C typescript build && pnpm -C python build",
    "build:docs": "livemark build",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "vp fmt --check && vp lint && pnpm -C rust check:lint",
    "check:types": "tsgo --noEmit && pnpm -C typescript check:types && pnpm -C rust check:types && pnpm -C python check:types",
    "format": "vp fmt --no-error-on-unmatched-pattern && pnpm -C rust format",
    "generate:bindings": "node .scripts/generate-bindings.ts",
    "measure:coverage": "pnpm -C typescript measure:coverage && pnpm -C rust measure:coverage",
    "prepare": "lefthook install && node .scripts/link-skills.ts && (command -v cargo >/dev/null && pnpm -C rust setup || true)",
    "read": "htmlpress start .humans",
    "scan": "pnpm scan:leaks && pnpm scan:vulns",
    "scan:leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "scan:vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/rust --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "squash": "node .scripts/squash-branch.ts",
    "start": "livemark start",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "vp test && pnpm -C typescript test:unit && pnpm -C rust test:unit && pnpm -C python test:unit && pnpm -C benchmark test:unit",
    "update:deps": "ncu -ws --root -u --cooldown 7d"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "^0.4.4",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@types/estree": "1.0.9",
    "@types/node": "24.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "8.20.0",
    "cn": "0.2.4",
    "gethtmlpress": "0.5.1",
    "lefthook": "2.1.1",
    "livemark": "0.44.0",
    "lucide-react": "0.577.0",
    "mdast-util-definition-list": "2.0.1",
    "mdast-util-directive": "3.1.1",
    "mdast-util-math": "3.0.0",
    "mdast-util-mdx": "3.0.0",
    "npm-check-updates": "23.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "tempy": "3.2.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.85.0",
    "zod": "^4.4.1"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
