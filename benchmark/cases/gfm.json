{
  "description": "Convert a README-like GFM document to HTML, with every library's GFM extensions on",
  "profile": "readme-gfm",
  "flavor": "gfm",
  "sizes": ["10KB", "1MB", "10MB"],
  "tools": {
    "10MB": [
      "textlane-rust",
      "textlane-rust-hast",
      "textlane-typescript",
      "textlane-typescript-hast",
      "textlane-python",
      "textlane-python-hast",
      "comrak",
      "pulldown-cmark",
      "cmark"
    ]
  }
}
