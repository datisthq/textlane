[
  {
    "description": "Blank lines",
    "specification": ["https://spec.commonmark.org/0.31.2/#blank-lines"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 227",
        "input": "  \n\naaa\n  \n\n# aaa\n\n  \n",
        "expected": {
          "html": "<p>aaa</p>\n<h1>aaa</h1>"
        }
      }
    ]
  },
  {
    "description": "Blank lines (tree)",
    "specification": ["https://spec.commonmark.org/0.31.2/#blank-lines"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"]],
    "tests": [
      {
        "description": "example 227",
        "input": "  \n\naaa\n  \n\n# aaa\n\n  \n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "aaa",
                    "position": {
                      "start": {
                        "line": 3,
                        "column": 1,
                        "offset": 4
                      },
                      "end": {
                        "line": 3,
                        "column": 4,
                        "offset": 7
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 3,
                    "column": 1,
                    "offset": 4
                  },
                  "end": {
                    "line": 3,
                    "column": 4,
                    "offset": 7
                  }
                }
              },
              {
                "type": "heading",
                "depth": 1,
                "children": [
                  {
                    "type": "text",
                    "value": "aaa",
                    "position": {
                      "start": {
                        "line": 6,
                        "column": 3,
                        "offset": 14
                      },
                      "end": {
                        "line": 6,
                        "column": 6,
                        "offset": 17
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 6,
                    "column": 1,
                    "offset": 12
                  },
                  "end": {
                    "line": 6,
                    "column": 6,
                    "offset": 17
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 9,
                "column": 1,
                "offset": 22
              }
            }
          }
        }
      }
    ]
  },
  {
    "description": "Blank lines (round trip)",
    "specification": ["https://spec.commonmark.org/0.31.2/#blank-lines"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"], ["md.stringify"]],
    "tests": [
      {
        "description": "example 227",
        "input": "  \n\naaa\n  \n\n# aaa\n\n  \n",
        "expected": {
          "md": "aaa\n\n# aaa\n"
        }
      }
    ]
  }
]
