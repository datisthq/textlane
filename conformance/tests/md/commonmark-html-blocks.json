[
  {
    "description": "HTML blocks",
    "specification": ["https://spec.commonmark.org/0.31.2/#html-blocks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 148",
        "input": "<table><tr><td>\n<pre>\n**Hello**,\n\n_world_.\n</pre>\n</td></tr></table>\n",
        "expected": {
          "html": "<table><tr><td>\n<pre>\n**Hello**,\n<p><em>world</em>.\n</pre></p>\n</td></tr></table>"
        }
      },
      {
        "description": "example 149",
        "input": "<table>\n  <tr>\n    <td>\n           hi\n    </td>\n  </tr>\n</table>\n\nokay.\n",
        "expected": {
          "html": "<table>\n  <tr>\n    <td>\n           hi\n    </td>\n  </tr>\n</table>\n<p>okay.</p>"
        }
      },
      {
        "description": "example 150",
        "input": " <div>\n  *hello*\n         <foo><a>\n",
        "expected": {
          "html": " <div>\n  *hello*\n         <foo><a>"
        }
      },
      {
        "description": "example 151",
        "input": "</div>\n*foo*\n",
        "expected": {
          "html": "</div>\n*foo*"
        }
      },
      {
        "description": "example 152",
        "input": "<DIV CLASS=\"foo\">\n\n*Markdown*\n\n</DIV>\n",
        "expected": {
          "html": "<DIV CLASS=\"foo\">\n<p><em>Markdown</em></p>\n</DIV>"
        }
      },
      {
        "description": "example 153",
        "input": "<div id=\"foo\"\n  class=\"bar\">\n</div>\n",
        "expected": {
          "html": "<div id=\"foo\"\n  class=\"bar\">\n</div>"
        }
      },
      {
        "description": "example 154",
        "input": "<div id=\"foo\" class=\"bar\n  baz\">\n</div>\n",
        "expected": {
          "html": "<div id=\"foo\" class=\"bar\n  baz\">\n</div>"
        }
      },
      {
        "description": "example 155",
        "input": "<div>\n*foo*\n\n*bar*\n",
        "expected": {
          "html": "<div>\n*foo*\n<p><em>bar</em></p>"
        }
      },
      {
        "description": "example 156",
        "input": "<div id=\"foo\"\n*hi*\n",
        "expected": {
          "html": "<div id=\"foo\"\n*hi*"
        }
      },
      {
        "description": "example 157",
        "input": "<div class\nfoo\n",
        "expected": {
          "html": "<div class\nfoo"
        }
      },
      {
        "description": "example 158",
        "input": "<div *???-&&&-<---\n*foo*\n",
        "expected": {
          "html": "<div *???-&&&-<---\n*foo*"
        }
      },
      {
        "description": "example 159",
        "input": "<div><a href=\"bar\">*foo*</a></div>\n",
        "expected": {
          "html": "<div><a href=\"bar\">*foo*</a></div>"
        }
      },
      {
        "description": "example 160",
        "input": "<table><tr><td>\nfoo\n</td></tr></table>\n",
        "expected": {
          "html": "<table><tr><td>\nfoo\n</td></tr></table>"
        }
      },
      {
        "description": "example 161",
        "input": "<div></div>\n``` c\nint x = 33;\n```\n",
        "expected": {
          "html": "<div></div>\n``` c\nint x = 33;\n```"
        }
      },
      {
        "description": "example 162",
        "input": "<a href=\"foo\">\n*bar*\n</a>\n",
        "expected": {
          "html": "<a href=\"foo\">\n*bar*\n</a>"
        }
      },
      {
        "description": "example 163",
        "input": "<Warning>\n*bar*\n</Warning>\n",
        "expected": {
          "html": "<Warning>\n*bar*\n</Warning>"
        }
      },
      {
        "description": "example 164",
        "input": "<i class=\"foo\">\n*bar*\n</i>\n",
        "expected": {
          "html": "<i class=\"foo\">\n*bar*\n</i>"
        }
      },
      {
        "description": "example 165",
        "input": "</ins>\n*bar*\n",
        "expected": {
          "html": "</ins>\n*bar*"
        }
      },
      {
        "description": "example 166",
        "input": "<del>\n*foo*\n</del>\n",
        "expected": {
          "html": "<del>\n*foo*\n</del>"
        }
      },
      {
        "description": "example 167",
        "input": "<del>\n\n*foo*\n\n</del>\n",
        "expected": {
          "html": "<del>\n<p><em>foo</em></p>\n</del>"
        }
      },
      {
        "description": "example 168",
        "input": "<del>*foo*</del>\n",
        "expected": {
          "html": "<p><del><em>foo</em></del></p>"
        }
      },
      {
        "description": "example 169",
        "input": "<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print $ parseTags tags\n</code></pre>\nokay\n",
        "expected": {
          "html": "<pre language=\"haskell\"><code>\nimport Text.HTML.TagSoup\n\nmain :: IO ()\nmain = print $ parseTags tags\n</code></pre>\n<p>okay</p>"
        }
      },
      {
        "description": "example 170",
        "input": "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\nokay\n",
        "expected": {
          "html": "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.getElementById(\"demo\").innerHTML = \"Hello JavaScript!\";\n</script>\n<p>okay</p>"
        }
      },
      {
        "description": "example 171",
        "input": "<textarea>\n\n*foo*\n\n_bar_\n\n</textarea>\n",
        "expected": {
          "html": "<textarea>\n\n*foo*\n\n_bar_\n\n</textarea>"
        }
      },
      {
        "description": "example 172",
        "input": "<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\nokay\n",
        "expected": {
          "html": "<style\n  type=\"text/css\">\nh1 {color:red;}\n\np {color:blue;}\n</style>\n<p>okay</p>"
        }
      },
      {
        "description": "example 173",
        "input": "<style\n  type=\"text/css\">\n\nfoo\n",
        "expected": {
          "html": "<style\n  type=\"text/css\">\n\nfoo\n"
        }
      },
      {
        "description": "example 174",
        "input": "> <div>\n> foo\n\nbar\n",
        "expected": {
          "html": "<blockquote>\n<div>\nfoo\n</blockquote>\n<p>bar</p>"
        }
      },
      {
        "description": "example 175",
        "input": "- <div>\n- foo\n",
        "expected": {
          "html": "<ul>\n<li>\n<div>\n</li>\n<li>foo</li>\n</ul>"
        }
      },
      {
        "description": "example 176",
        "input": "<style>p{color:red;}</style>\n*foo*\n",
        "expected": {
          "html": "<style>p{color:red;}</style>\n<p><em>foo</em></p>"
        }
      },
      {
        "description": "example 177",
        "input": "<!-- foo -->*bar*\n*baz*\n",
        "expected": {
          "html": "<!-- foo -->*bar*\n<p><em>baz</em></p>"
        }
      },
      {
        "description": "example 178",
        "input": "<script>\nfoo\n</script>1. *bar*\n",
        "expected": {
          "html": "<script>\nfoo\n</script>1. *bar*"
        }
      },
      {
        "description": "example 179",
        "input": "<!-- Foo\n\nbar\n   baz -->\nokay\n",
        "expected": {
          "html": "<!-- Foo\n\nbar\n   baz -->\n<p>okay</p>"
        }
      },
      {
        "description": "example 180",
        "input": "<?php\n\n  echo '>';\n\n?>\nokay\n",
        "expected": {
          "html": "<?php\n\n  echo '>';\n\n?>\n<p>okay</p>"
        }
      },
      {
        "description": "example 181",
        "input": "<!DOCTYPE html>\n",
        "expected": {
          "html": "<!DOCTYPE html>"
        }
      },
      {
        "description": "example 182",
        "input": "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\nokay\n",
        "expected": {
          "html": "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) then {\n    return 1;\n\n  } else {\n\n    return 0;\n  }\n}\n]]>\n<p>okay</p>"
        }
      },
      {
        "description": "example 183",
        "input": "  <!-- foo -->\n\n    <!-- foo -->\n",
        "expected": {
          "html": "  <!-- foo -->\n<pre><code>&#x3C;!-- foo -->\n</code></pre>"
        }
      },
      {
        "description": "example 184",
        "input": "  <div>\n\n    <div>\n",
        "expected": {
          "html": "  <div>\n<pre><code>&#x3C;div>\n</code></pre>"
        }
      },
      {
        "description": "example 185",
        "input": "Foo\n<div>\nbar\n</div>\n",
        "expected": {
          "html": "<p>Foo</p>\n<div>\nbar\n</div>"
        }
      },
      {
        "description": "example 186",
        "input": "<div>\nbar\n</div>\n*foo*\n",
        "expected": {
          "html": "<div>\nbar\n</div>\n*foo*"
        }
      },
      {
        "description": "example 187",
        "input": "Foo\n<a href=\"bar\">\nbaz\n",
        "expected": {
          "html": "<p>Foo\n<a href=\"bar\">\nbaz</p>"
        }
      },
      {
        "description": "example 188",
        "input": "<div>\n\n*Emphasized* text.\n\n</div>\n",
        "expected": {
          "html": "<div>\n<p><em>Emphasized</em> text.</p>\n</div>"
        }
      },
      {
        "description": "example 189",
        "input": "<div>\n*Emphasized* text.\n</div>\n",
        "expected": {
          "html": "<div>\n*Emphasized* text.\n</div>"
        }
      },
      {
        "description": "example 190",
        "input": "<table>\n\n<tr>\n\n<td>\nHi\n</td>\n\n</tr>\n\n</table>\n",
        "expected": {
          "html": "<table>\n<tr>\n<td>\nHi\n</td>\n</tr>\n</table>"
        }
      },
      {
        "description": "example 191",
        "input": "<table>\n\n  <tr>\n\n    <td>\n      Hi\n    </td>\n\n  </tr>\n\n</table>\n",
        "expected": {
          "html": "<table>\n  <tr>\n<pre><code>&#x3C;td>\n  Hi\n&#x3C;/td>\n</code></pre>\n  </tr>\n</table>"
        }
      }
    ]
  }
]
