[
  {
    "description": "custom heading ids",
    "comment": "remark-heading-id's `defaults` option is not ported: html.slug makes ids",
    "source": {
      "repository": "https://github.com/imcuttle/remark-heading-id",
      "version": "1.0.1",
      "path": "index.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.headingId"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "an id after a space",
        "input": "# Hello {#hi}",
        "expected": {
          "html": "<h1 id=\"hi\">Hello</h1>"
        }
      },
      {
        "description": "trailing spaces after the id",
        "input": "# Hello {#hi}   ",
        "expected": {
          "html": "<h1 id=\"hi\">Hello</h1>"
        }
      },
      {
        "description": "no space before the id",
        "input": "# Hello{#hi}",
        "expected": {
          "html": "<h1>Hello{#hi}</h1>"
        }
      },
      {
        "description": "an id after emphasis",
        "input": "# Hello *big* {#x}",
        "expected": {
          "html": "<h1 id=\"x\">Hello <em>big</em></h1>"
        }
      },
      {
        "description": "an id after code",
        "input": "# A `b` {#c}",
        "expected": {
          "html": "<h1 id=\"c\">A <code>b</code></h1>"
        }
      },
      {
        "description": "the last braces of two",
        "input": "## A {#a} {#b}",
        "expected": {
          "html": "<h2 id=\"a} {#b\">A</h2>"
        }
      },
      {
        "description": "an empty id",
        "input": "# A {#}",
        "expected": {
          "html": "<h1>A {#}</h1>"
        }
      },
      {
        "description": "an id with a space",
        "input": "# A {#x y}",
        "expected": {
          "html": "<h1 id=\"x y\">A</h1>"
        }
      },
      {
        "description": "a setext heading",
        "input": "A {#s}\n===",
        "expected": {
          "html": "<h1 id=\"s\">A</h1>"
        }
      },
      {
        "description": "a heading without an id",
        "input": "# Plain",
        "expected": {
          "html": "<h1>Plain</h1>"
        }
      },
      {
        "description": "several headings",
        "input": "# A {#one}\n\n## B\n\n### C {#three}",
        "expected": {
          "html": "<h1 id=\"one\">A</h1>\n<h2>B</h2>\n<h3 id=\"three\">C</h3>"
        }
      }
    ]
  },
  {
    "description": "attribute lists, with attributes: true",
    "comment": "textlane's own: `{#id .class key=value}` read as md.directive reads attributes; no upstream",
    "pipeline": [
      ["md.parse"],
      [
        "md.headingId",
        {
          "attributes": true
        }
      ],
      ["md.toHtml"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "an id",
        "input": "# Install {#setup}",
        "expected": {
          "html": "<h1 id=\"setup\">Install</h1>"
        }
      },
      {
        "description": "an id, classes and values",
        "input": "## API {#api .wide .dark data-step=2 title=\"The API\"}",
        "expected": {
          "html": "<h2 id=\"api\" class=\"wide dark\" data-step=\"2\" title=\"The API\">API</h2>"
        }
      },
      {
        "description": "classes only",
        "input": "# A {.note}",
        "expected": {
          "html": "<h1 class=\"note\">A</h1>"
        }
      },
      {
        "description": "a list that does not end the text",
        "input": "# A {.x} b",
        "expected": {
          "html": "<h1>A {.x} b</h1>"
        }
      },
      {
        "description": "the last braces win",
        "input": "# A {.x} {#y}",
        "expected": {
          "html": "<h1 id=\"y\">A {.x}</h1>"
        }
      },
      {
        "description": "invalid attributes stay text",
        "input": "# A {=x}",
        "expected": {
          "html": "<h1>A {=x}</h1>"
        }
      },
      {
        "description": "no space before the braces",
        "input": "# A{#x}",
        "expected": {
          "html": "<h1>A{#x}</h1>"
        }
      },
      {
        "description": "trailing spaces",
        "input": "# A {#x}   ",
        "expected": {
          "html": "<h1 id=\"x\">A</h1>"
        }
      },
      {
        "description": "a heading without attributes",
        "input": "# Plain",
        "expected": {
          "html": "<h1>Plain</h1>"
        }
      }
    ]
  },
  {
    "description": "markers turn heading suffixes into attributes",
    "comment": "textlane's own: literal suffixes such as livemark's `[step]` and `[!toc]`",
    "pipeline": [
      ["md.parse"],
      [
        "md.headingId",
        {
          "attributes": true,
          "markers": {
            "[step]": {
              "data-step": true
            },
            "[!toc]": {
              "data-toc-hidden": true
            },
            "[toc]": {
              "hidden": true
            },
            "[x]": {
              "data-kind": "note",
              "onclick": "bad"
            }
          }
        }
      ],
      ["md.toHtml"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "a flag marker",
        "input": "## Install [step]",
        "expected": {
          "html": "<h2 data-step>Install</h2>"
        }
      },
      {
        "description": "no space before the marker",
        "input": "## Install[step]",
        "expected": {
          "html": "<h2 data-step>Install</h2>"
        }
      },
      {
        "description": "the longer marker of two that end alike",
        "input": "## Notes [!toc]",
        "expected": {
          "html": "<h2 data-toc-hidden>Notes</h2>"
        }
      },
      {
        "description": "a marker and an attribute list, either order",
        "input": "## A [step] {#a}\n\n## B {#b} [step]",
        "expected": {
          "html": "<h2 id=\"a\" data-step>A</h2>\n<h2 data-step id=\"b\">B</h2>"
        }
      },
      {
        "description": "two markers",
        "input": "## A [step] [!toc]",
        "expected": {
          "html": "<h2 data-toc-hidden data-step>A</h2>"
        }
      },
      {
        "description": "a marker with a value, handlers dropped",
        "input": "## A [x]",
        "expected": {
          "html": "<h2 data-kind=\"note\">A</h2>"
        }
      },
      {
        "description": "a marker inside the text stays",
        "input": "## A [step] b",
        "expected": {
          "html": "<h2>A [step] b</h2>"
        }
      },
      {
        "description": "a heading without markers",
        "input": "## Plain",
        "expected": {
          "html": "<h2>Plain</h2>"
        }
      }
    ]
  }
]
