                    "type": "text",
                    "value": "hi",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 3,
                        "offset": 2
                      },
                      "end": {
                        "line": 1,
                        "column": 5,
                        "offset": 4
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 5,
                    "offset": 4
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 1,
                "column": 5,
                "offset": 4
              }
            }
          }
