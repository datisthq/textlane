[
  {
    "description": "remark-breaks fixtures",
    "source": {
      "repository": "https://github.com/remarkjs/remark-breaks",
      "commit": "71f4ff3ca9f08b685dccf2fdb9882d8bbaea3388",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "breaks": true
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "no space",
        "input": "This is a\nparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "one space",
        "input": "This is a \nparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "two spaces",
        "input": "This is a  \nparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "three spaces",
        "input": "This is a   \nparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "carriage return",
        "input": "This is a\rparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "carriage return + line feed",
        "input": "This is a\r\nparagraph.",
        "expected": {
          "html": "<p>This is a<br>\nparagraph.</p>"
        }
      },
      {
        "description": "after phrasing",
        "input": "After *phrasing*\nmore.",
        "expected": {
          "html": "<p>After <em>phrasing</em><br>\nmore.</p>"
        }
      },
      {
        "description": "before phrasing",
        "input": "Before\n*phrasing*.",
        "expected": {
          "html": "<p>Before<br>\n<em>phrasing</em>.</p>"
        }
      },
      {
        "description": "multiple",
        "input": "Mul\nti\nple.",
        "expected": {
          "html": "<p>Mul<br>\nti<br>\nple.</p>"
        }
      },
      {
        "description": "none",
        "input": "None.",
        "expected": {
          "html": "<p>None.</p>"
        }
      },
      {
        "description": "document",
        "input": "no space\nasd\n\none space \nasd\n\none tab\t\nasd\n\nin an ![image\nalt](#)\n\nin a [link\nalt](#)\n\nin an *emphasis\nemphasis*.\n\nin a **strong\nstrong**.\n\nsetext\nheading\n===\n\n> block\n> quote.\n\n* list\n  item.",
        "expected": {
          "html": "<p>no space<br>\nasd</p>\n<p>one space<br>\nasd</p>\n<p>one tab<br>\nasd</p>\n<p>in an <img src=\"#\" alt=\"image\nalt\"></p>\n<p>in a <a href=\"#\">link<br>\nalt</a></p>\n<p>in an <em>emphasis<br>\nemphasis</em>.</p>\n<p>in a <strong>strong<br>\nstrong</strong>.</p>\n<h1>setext<br>\nheading</h1>\n<blockquote>\n<p>block<br>\nquote.</p>\n</blockquote>\n<ul>\n<li>list<br>\nitem.</li>\n</ul>"
        }
      }
    ]
  },
