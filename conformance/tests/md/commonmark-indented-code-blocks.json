[
  {
    "description": "Indented code blocks",
    "specification": ["https://spec.commonmark.org/0.31.2/#indented-code-blocks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 107",
        "input": "    a simple\n      indented code block\n",
        "expected": {
          "html": "<pre><code>a simple\n  indented code block\n</code></pre>"
        }
      },
      {
        "description": "example 108",
        "input": "  - foo\n\n    bar\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 109",
        "input": "1.  foo\n\n    - bar\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 110",
        "input": "    <a/>\n    *hi*\n\n    - one\n",
        "expected": {
          "html": "<pre><code>&#x3C;a/>\n*hi*\n\n- one\n</code></pre>"
        }
      },
      {
        "description": "example 111",
        "input": "    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n",
        "expected": {
          "html": "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>"
        }
      },
      {
        "description": "example 112",
        "input": "    chunk1\n      \n      chunk2\n",
        "expected": {
          "html": "<pre><code>chunk1\n  \n  chunk2\n</code></pre>"
        }
      },
      {
        "description": "example 113",
        "input": "Foo\n    bar\n\n",
        "expected": {
          "html": "<p>Foo\nbar</p>"
        }
      },
      {
        "description": "example 114",
        "input": "    foo\nbar\n",
        "expected": {
          "html": "<pre><code>foo\n</code></pre>\n<p>bar</p>"
        }
      },
      {
        "description": "example 115",
        "input": "# Heading\n    foo\nHeading\n------\n    foo\n----\n",
        "expected": {
          "html": "<h1>Heading</h1>\n<pre><code>foo\n</code></pre>\n<h2>Heading</h2>\n<pre><code>foo\n</code></pre>\n<hr>"
        }
      },
      {
        "description": "example 116",
        "input": "        foo\n    bar\n",
        "expected": {
          "html": "<pre><code>    foo\nbar\n</code></pre>"
        }
      },
      {
        "description": "example 117",
        "input": "\n    \n    foo\n    \n\n",
        "expected": {
          "html": "<pre><code>foo\n</code></pre>"
        }
      },
      {
        "description": "example 118",
        "input": "    foo  \n",
        "expected": {
          "html": "<pre><code>foo  \n</code></pre>"
        }
      }
    ]
  }
]
