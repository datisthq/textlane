[
  {
    "description": "a container rule names its component from the directive and takes its label",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": ["note", "tip", "info", "warning", "danger"],
              "kind": "container",
              "component": "Callout",
              "nameAs": "type",
              "labelAs": "title",
              "attributes": []
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "the label becomes an attribute",
        "input": ":::note[Heads up]\nBody\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Callout",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "type",
                    "value": "note"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "title",
                    "value": "Heads up"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "Body",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "no label, no attribute",
        "input": ":::tip\nBody\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Callout",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "type",
                    "value": "tip"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "Body",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "the label's whole text, emphasis included",
        "input": ":::note[Heads *up*]\nBody\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Callout",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "type",
                    "value": "note"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "title",
                    "value": "Heads up"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "Body",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "another kind of directive stays",
        "input": "::note",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "note",
                "attributes": {},
                "type": "leafDirective",
                "children": []
              }
            ]
          }
        }
      },
      {
        "description": "other attributes are dropped when the list is empty",
        "input": ":::warning{x=1}\nBody\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Callout",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "type",
                    "value": "warning"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "Body",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      }
    ],
    "comment": "md.component is textlane's own plugin, with no upstream: these cases are its specification, written for livemark's components (Callout, Card, ContentTabs and the rest)"
  },
  {
    "description": "text rules take their content as an attribute",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": "badge",
              "kind": "text",
              "component": "InlineBadge",
              "labelAs": "label",
              "attributes": ["variant"]
            },
            {
              "name": "abbr",
              "kind": "text",
              "component": "Abbr",
              "labelAs": "text",
              "attributes": [
                {
                  "name": "title",
                  "default": ""
                }
              ]
            },
            {
              "name": "icon",
              "kind": "text",
              "component": "InlineIcon",
              "attributes": ["name", "className"],
              "required": ["name"]
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "a badge",
        "input": "New :badge[beta]{variant=info}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "value": "New ",
                    "type": "text"
                  },
                  {
                    "name": "InlineBadge",
                    "attributes": [
                      {
                        "type": "mdxJsxAttribute",
                        "name": "label",
                        "value": "beta"
                      },
                      {
                        "type": "mdxJsxAttribute",
                        "name": "variant",
                        "value": "info"
                      }
                    ],
                    "type": "mdxJsxTextElement",
                    "children": [],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "an abbreviation",
        "input": "The :abbr[HTML]{title=\"HyperText Markup Language\"} spec",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "value": "The ",
                    "type": "text"
                  },
                  {
                    "name": "Abbr",
                    "attributes": [
                      {
                        "type": "mdxJsxAttribute",
                        "name": "text",
                        "value": "HTML"
                      },
                      {
                        "type": "mdxJsxAttribute",
                        "name": "title",
                        "value": "HyperText Markup Language"
                      }
                    ],
                    "type": "mdxJsxTextElement",
                    "children": [],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  },
                  {
                    "value": " spec",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "an abbreviation without a title takes the default",
        "input": ":abbr[CSS]",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "name": "Abbr",
                    "attributes": [
                      {
                        "type": "mdxJsxAttribute",
                        "name": "text",
                        "value": "CSS"
                      },
                      {
                        "type": "mdxJsxAttribute",
                        "name": "title",
                        "value": ""
                      }
                    ],
                    "type": "mdxJsxTextElement",
                    "children": [],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "an icon",
        "input": ":icon{name=star className=big}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "name": "InlineIcon",
                    "attributes": [
                      {
                        "type": "mdxJsxAttribute",
                        "name": "name",
                        "value": "star"
                      },
                      {
                        "type": "mdxJsxAttribute",
                        "name": "className",
                        "value": "big"
                      }
                    ],
                    "type": "mdxJsxTextElement",
                    "children": [],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "an icon without its required name stays a directive",
        "input": ":icon{className=big}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "name": "icon",
                    "attributes": {
                      "className": "big"
                    },
                    "type": "textDirective",
                    "children": []
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "a leaf rule's label beats an attribute of the same name",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": "button",
              "kind": "leaf",
              "component": "LinkButton",
              "labelAs": "label",
              "attributes": ["href", "label", "variant"],
              "required": ["href", "label"]
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "the label",
        "input": "::button[Start]{href=/start variant=primary}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "LinkButton",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "href",
                    "value": "/start"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "label",
                    "value": "Start"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "variant",
                    "value": "primary"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "the attribute when there is no label",
        "input": "::button{href=/start label=Go}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "LinkButton",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "href",
                    "value": "/start"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "label",
                    "value": "Go"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "without the required href it stays",
        "input": "::button[Start]",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "button",
                "attributes": {},
                "type": "leafDirective",
                "children": [
                  {
                    "value": "Start",
                    "type": "text"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "a rule matches only directives whose attributes it names in where",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": "video",
              "kind": "leaf",
              "where": {
                "type": "youtube"
              },
              "component": "YouTube",
              "attributes": ["id"],
              "required": ["id"]
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "a matching directive",
        "input": "::video{type=youtube id=abc}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "YouTube",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "id",
                    "value": "abc"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "another value stays",
        "input": "::video{type=vimeo id=abc}",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "video",
                "attributes": {
                  "type": "vimeo",
                  "id": "abc"
                },
                "type": "leafDirective",
                "children": []
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "attributes are renamed and defaulted in the order listed",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": "card",
              "kind": "container",
              "component": "Card",
              "attributes": [
                {
                  "name": "title",
                  "default": ""
                },
                {
                  "name": "to",
                  "rename": "href"
                },
                "icon"
              ]
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "renamed, defaulted and ordered",
        "input": ":::card{icon=book to=/docs}\nRead\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Card",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "title",
                    "value": ""
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "href",
                    "value": "/docs"
                  },
                  {
                    "type": "mdxJsxAttribute",
                    "name": "icon",
                    "value": "book"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "Read",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "a label the rule does not take stays content",
        "input": ":::card[Docs]\nRead\n:::",
