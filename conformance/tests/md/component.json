  {
    "description": "adjacent siblings one rule converted are grouped",
    "pipeline": [
      ["md.parse"],
      ["md.directive"],
      [
        "md.component",
        {
          "directives": [
            {
              "name": "card",
              "kind": "container",
              "component": "Card",
              "attributes": [],
              "group": {
                "component": "Cards"
              }
            },
            {
              "name": "tab",
              "kind": "container",
              "component": "ContentTab",
              "attributes": ["title", "sync"],
              "group": {
                "component": "ContentTabs",
                "min": 1,
                "inherit": ["sync"]
              }
            }
          ]
        }
      ]
    ],
    "positions": false,
    "tests": [
      {
        "description": "two cards",
        "input": ":::card\nA\n:::\n\n:::card\nB\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Cards",
                "attributes": [],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "name": "Card",
                    "attributes": [],
                    "type": "mdxJsxFlowElement",
                    "children": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "value": "A",
                            "type": "text"
                          }
                        ]
                      }
                    ],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  },
                  {
                    "name": "Card",
                    "attributes": [],
                    "type": "mdxJsxFlowElement",
                    "children": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "value": "B",
                            "type": "text"
                          }
                        ]
                      }
                    ],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "one card is not grouped below the minimum",
        "input": ":::card\nA\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Card",
                "attributes": [],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "A",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "a paragraph between cards splits the run",
        "input": ":::card\nA\n:::\n\nx\n\n:::card\nB\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "Card",
                "attributes": [],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "A",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              },
              {
                "type": "paragraph",
                "children": [
                  {
                    "value": "x",
                    "type": "text"
                  }
                ]
              },
              {
                "name": "Card",
                "attributes": [],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "value": "B",
                        "type": "text"
                      }
                    ]
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "one tab is a group of its own, inheriting sync",
        "input": ":::tab{title=A sync=pm}\nA\n:::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "ContentTabs",
                "attributes": [
                  {
                    "type": "mdxJsxAttribute",
                    "name": "sync",
                    "value": "pm"
                  }
                ],
                "type": "mdxJsxFlowElement",
                "children": [
                  {
                    "name": "ContentTab",
                    "attributes": [
                      {
                        "type": "mdxJsxAttribute",
                        "name": "title",
                        "value": "A"
                      },
                      {
                        "type": "mdxJsxAttribute",
                        "name": "sync",
                        "value": "pm"
                      }
                    ],
                    "type": "mdxJsxFlowElement",
                    "children": [
                      {
                        "type": "paragraph",
                        "children": [
                          {
                            "value": "A",
                            "type": "text"
                          }
                        ]
                      }
                    ],
                    "data": {
                      "_mdxExplicitJsx": true
                    }
                  }
                ],
                "data": {
                  "_mdxExplicitJsx": true
                }
              }
            ]
          }
        }
      },
      {
        "description": "cards inside a tab group too",
        "input": "::::tab{title=A}\n:::card\nA\n:::\n\n:::card\nB\n:::\n::::",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "name": "ContentTabs",
                "attributes": [],
                "type": "mdxJsxFlowElement",
                "children": [
