[
  {
    "description": "Hard line breaks",
    "specification": ["https://spec.commonmark.org/0.31.2/#hard-line-breaks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 633",
        "input": "foo  \nbaz\n",
        "expected": {
          "html": "<p>foo<br>\nbaz</p>"
        }
      },
      {
        "description": "example 634",
        "input": "foo\\\nbaz\n",
        "expected": {
          "html": "<p>foo<br>\nbaz</p>"
        }
      },
      {
        "description": "example 635",
        "input": "foo       \nbaz\n",
        "expected": {
          "html": "<p>foo<br>\nbaz</p>"
        }
      },
      {
        "description": "example 636",
        "input": "foo  \n     bar\n",
        "expected": {
          "html": "<p>foo<br>\nbar</p>"
        }
      },
      {
        "description": "example 637",
        "input": "foo\\\n     bar\n",
        "expected": {
          "html": "<p>foo<br>\nbar</p>"
        }
      },
      {
        "description": "example 638",
        "input": "*foo  \nbar*\n",
        "expected": {
          "html": "<p><em>foo<br>\nbar</em></p>"
        }
      },
      {
        "description": "example 639",
        "input": "*foo\\\nbar*\n",
        "expected": {
          "html": "<p><em>foo<br>\nbar</em></p>"
        }
      },
      {
        "description": "example 640",
        "input": "`code  \nspan`\n",
        "expected": {
          "html": "<p><code>code   span</code></p>"
        }
      },
      {
        "description": "example 641",
        "input": "`code\\\nspan`\n",
        "expected": {
          "html": "<p><code>code\\ span</code></p>"
        }
      },
      {
        "description": "example 642",
        "input": "<a href=\"foo  \nbar\">\n",
        "expected": {
          "html": "<p><a href=\"foo  \nbar\"></p>"
        }
      },
      {
        "description": "example 643",
        "input": "<a href=\"foo\\\nbar\">\n",
        "expected": {
          "html": "<p><a href=\"foo\\\nbar\"></p>"
        }
      },
      {
        "description": "example 644",
        "input": "foo\\\n",
        "expected": {
          "html": "<p>foo\\</p>"
        }
      },
      {
        "description": "example 645",
        "input": "foo  \n",
        "expected": {
          "html": "<p>foo</p>"
        }
      },
      {
        "description": "example 646",
        "input": "### foo\\\n",
        "expected": {
          "html": "<h3>foo\\</h3>"
        }
      },
      {
        "description": "example 647",
        "input": "### foo  \n",
        "expected": {
          "html": "<h3>foo</h3>"
        }
      }
    ]
  }
]
