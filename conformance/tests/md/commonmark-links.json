[
  {
    "description": "Links",
    "specification": ["https://spec.commonmark.org/0.31.2/#links"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 482",
        "input": "[link](/uri \"title\")\n",
        "expected": {
          "html": "<p><a href=\"/uri\" title=\"title\">link</a></p>"
        }
      },
      {
        "description": "example 483",
        "input": "[link](/uri)\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link</a></p>"
        }
      },
      {
        "description": "example 484",
        "input": "[](./target.md)\n",
        "expected": {
          "html": "<p><a href=\"./target.md\"></a></p>"
        }
      },
      {
        "description": "example 485",
        "input": "[link]()\n",
        "expected": {
          "html": "<p><a href=\"\">link</a></p>"
        }
      },
      {
        "description": "example 486",
        "input": "[link](<>)\n",
        "expected": {
          "html": "<p><a href=\"\">link</a></p>"
        }
      },
      {
        "description": "example 487",
        "input": "[]()\n",
        "expected": {
          "html": "<p><a href=\"\"></a></p>"
        }
      },
      {
        "description": "example 488",
        "input": "[link](/my uri)\n",
        "expected": {
          "html": "<p>[link](/my uri)</p>"
        }
      },
      {
        "description": "example 489",
        "input": "[link](</my uri>)\n",
        "expected": {
          "html": "<p><a href=\"/my%20uri\">link</a></p>"
        }
      },
      {
        "description": "example 490",
        "input": "[link](foo\nbar)\n",
        "expected": {
          "html": "<p>[link](foo\nbar)</p>"
        }
      },
      {
        "description": "example 491",
        "input": "[link](<foo\nbar>)\n",
        "expected": {
          "html": "<p>[link](<foo\nbar>)</p>"
        }
      },
      {
        "description": "example 492",
        "input": "[a](<b)c>)\n",
        "expected": {
          "html": "<p><a href=\"b)c\">a</a></p>"
        }
      },
      {
        "description": "example 493",
        "input": "[link](<foo\\>)\n",
        "expected": {
          "html": "<p>[link](&#x3C;foo>)</p>"
        }
      },
      {
        "description": "example 494",
        "input": "[a](<b)c\n[a](<b)c>\n[a](<b>c)\n",
        "expected": {
          "html": "<p>[a](&#x3C;b)c\n[a](&#x3C;b)c>\n[a](<b>c)</p>"
        }
      },
      {
        "description": "example 495",
        "input": "[link](\\(foo\\))\n",
        "expected": {
          "html": "<p><a href=\"(foo)\">link</a></p>"
        }
      },
      {
        "description": "example 496",
        "input": "[link](foo(and(bar)))\n",
        "expected": {
          "html": "<p><a href=\"foo(and(bar))\">link</a></p>"
        }
      },
      {
        "description": "example 497",
        "input": "[link](foo(and(bar))\n",
        "expected": {
          "html": "<p>[link](foo(and(bar))</p>"
        }
      },
      {
        "description": "example 498",
        "input": "[link](foo\\(and\\(bar\\))\n",
        "expected": {
          "html": "<p><a href=\"foo(and(bar)\">link</a></p>"
        }
      },
      {
        "description": "example 499",
        "input": "[link](<foo(and(bar)>)\n",
        "expected": {
          "html": "<p><a href=\"foo(and(bar)\">link</a></p>"
        }
      },
      {
        "description": "example 500",
        "input": "[link](foo\\)\\:)\n",
        "expected": {
          "html": "<p><a href=\"foo):\">link</a></p>"
        }
      },
      {
        "description": "example 501",
        "input": "[link](#fragment)\n\n[link](https://example.com#fragment)\n\n[link](https://example.com?foo=3#frag)\n",
        "expected": {
          "html": "<p><a href=\"#fragment\">link</a></p>\n<p><a href=\"https://example.com#fragment\">link</a></p>\n<p><a href=\"https://example.com?foo=3#frag\">link</a></p>"
        }
      },
      {
        "description": "example 502",
        "input": "[link](foo\\bar)\n",
        "expected": {
          "html": "<p><a href=\"foo%5Cbar\">link</a></p>"
        }
      },
      {
        "description": "example 503",
        "input": "[link](foo%20b&auml;)\n",
        "expected": {
          "html": "<p><a href=\"foo%20b%C3%A4\">link</a></p>"
        }
      },
      {
        "description": "example 504",
        "input": "[link](\"title\")\n",
        "expected": {
          "html": "<p><a href=\"%22title%22\">link</a></p>"
        }
      },
      {
        "description": "example 505",
        "input": "[link](/url \"title\")\n[link](/url 'title')\n[link](/url (title))\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a>\n<a href=\"/url\" title=\"title\">link</a></p>"
        }
      },
      {
        "description": "example 506",
        "input": "[link](/url \"title \\\"&quot;\")\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title &#x22;&#x22;\">link</a></p>"
        }
      },
      {
        "description": "example 507",
        "input": "[link](/url \"title\")\n",
        "expected": {
          "html": "<p><a href=\"/url%C2%A0%22title%22\">link</a></p>"
        }
      },
      {
        "description": "example 508",
        "input": "[link](/url \"title \"and\" title\")\n",
        "expected": {
          "html": "<p>[link](/url \"title \"and\" title\")</p>"
        }
      },
      {
        "description": "example 509",
        "input": "[link](/url 'title \"and\" title')\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title &#x22;and&#x22; title\">link</a></p>"
        }
      },
      {
        "description": "example 510",
        "input": "[link](   /uri\n  \"title\"  )\n",
        "expected": {
          "html": "<p><a href=\"/uri\" title=\"title\">link</a></p>"
        }
      },
      {
        "description": "example 511",
        "input": "[link] (/uri)\n",
        "expected": {
          "html": "<p>[link] (/uri)</p>"
        }
      },
      {
        "description": "example 512",
        "input": "[link [foo [bar]]](/uri)\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link [foo [bar]]</a></p>"
        }
      },
      {
        "description": "example 513",
        "input": "[link] bar](/uri)\n",
        "expected": {
          "html": "<p>[link] bar](/uri)</p>"
        }
      },
      {
        "description": "example 514",
        "input": "[link [bar](/uri)\n",
        "expected": {
          "html": "<p>[link <a href=\"/uri\">bar</a></p>"
        }
      },
      {
        "description": "example 515",
        "input": "[link \\[bar](/uri)\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link [bar</a></p>"
        }
      },
      {
        "description": "example 516",
        "input": "[link *foo **bar** `#`*](/uri)\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>"
        }
      },
      {
        "description": "example 517",
        "input": "[![moon](moon.jpg)](/uri)\n",
        "expected": {
          "html": "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\"></a></p>"
        }
      },
      {
        "description": "example 518",
        "input": "[foo [bar](/uri)](/uri)\n",
        "expected": {
          "html": "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>"
        }
      },
      {
        "description": "example 519",
        "input": "[foo *[bar [baz](/uri)](/uri)*](/uri)\n",
        "expected": {
          "html": "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>"
        }
      },
      {
        "description": "example 520",
        "input": "![[[foo](uri1)](uri2)](uri3)\n",
        "expected": {
          "html": "<p><img src=\"uri3\" alt=\"[foo](uri2)\"></p>"
        }
      },
      {
        "description": "example 521",
        "input": "*[foo*](/uri)\n",
        "expected": {
          "html": "<p>*<a href=\"/uri\">foo*</a></p>"
        }
      },
      {
        "description": "example 522",
        "input": "[foo *bar](baz*)\n",
        "expected": {
          "html": "<p><a href=\"baz*\">foo *bar</a></p>"
        }
      },
      {
        "description": "example 523",
        "input": "*foo [bar* baz]\n",
        "expected": {
          "html": "<p><em>foo [bar</em> baz]</p>"
        }
      },
      {
        "description": "example 524",
        "input": "[foo <bar attr=\"](baz)\">\n",
        "expected": {
          "html": "<p>[foo <bar attr=\"](baz)\"></p>"
        }
      },
      {
        "description": "example 525",
        "input": "[foo`](/uri)`\n",
        "expected": {
          "html": "<p>[foo<code>](/uri)</code></p>"
        }
      },
      {
        "description": "example 526",
        "input": "[foo<https://example.com/?search=](uri)>\n",
        "expected": {
          "html": "<p>[foo<a href=\"https://example.com/?search=%5D(uri)\">https://example.com/?search=](uri)</a></p>"
        }
      },
      {
        "description": "example 527",
        "input": "[foo][bar]\n\n[bar]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">foo</a></p>"
        }
      },
      {
        "description": "example 528",
        "input": "[link [foo [bar]]][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link [foo [bar]]</a></p>"
        }
      },
      {
        "description": "example 529",
        "input": "[link \\[bar][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link [bar</a></p>"
        }
      },
      {
        "description": "example 530",
        "input": "[link *foo **bar** `#`*][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>"
        }
      },
      {
        "description": "example 531",
        "input": "[![moon](moon.jpg)][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\"></a></p>"
        }
      },
      {
        "description": "example 532",
        "input": "[foo [bar](/uri)][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>[foo <a href=\"/uri\">bar</a>]<a href=\"/uri\">ref</a></p>"
        }
      },
      {
        "description": "example 533",
        "input": "[foo *bar [baz][ref]*][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>[foo <em>bar <a href=\"/uri\">baz</a></em>]<a href=\"/uri\">ref</a></p>"
        }
      },
      {
        "description": "example 534",
        "input": "*[foo*][ref]\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>*<a href=\"/uri\">foo*</a></p>"
        }
      },
      {
        "description": "example 535",
        "input": "[foo *bar][ref]*\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\">foo *bar</a>*</p>"
        }
      },
      {
        "description": "example 536",
        "input": "[foo <bar attr=\"][ref]\">\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>[foo <bar attr=\"][ref]\"></p>"
        }
      },
      {
        "description": "example 537",
        "input": "[foo`][ref]`\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>[foo<code>][ref]</code></p>"
        }
      },
      {
        "description": "example 538",
        "input": "[foo<https://example.com/?search=][ref]>\n\n[ref]: /uri\n",
        "expected": {
          "html": "<p>[foo<a href=\"https://example.com/?search=%5D%5Bref%5D\">https://example.com/?search=][ref]</a></p>"
        }
      },
      {
        "description": "example 539",
        "input": "[foo][BaR]\n\n[bar]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">foo</a></p>"
        }
      },
      {
        "description": "example 540",
        "input": "[ẞ]\n\n[SS]: /url\n",
        "expected": {
          "html": "<p><a href=\"/url\">ẞ</a></p>"
        }
      },
      {
        "description": "example 541",
        "input": "[Foo\n  bar]: /url\n\n[Baz][Foo bar]\n",
        "expected": {
          "html": "<p><a href=\"/url\">Baz</a></p>"
        }
      },
      {
        "description": "example 542",
        "input": "[foo] [bar]\n\n[bar]: /url \"title\"\n",
        "expected": {
          "html": "<p>[foo] <a href=\"/url\" title=\"title\">bar</a></p>"
        }
      },
      {
        "description": "example 543",
        "input": "[foo]\n[bar]\n\n[bar]: /url \"title\"\n",
        "expected": {
          "html": "<p>[foo]\n<a href=\"/url\" title=\"title\">bar</a></p>"
        }
      },
      {
        "description": "example 544",
        "input": "[foo]: /url1\n\n[foo]: /url2\n\n[bar][foo]\n",
        "expected": {
          "html": "<p><a href=\"/url1\">bar</a></p>"
        }
      },
      {
        "description": "example 545",
        "input": "[bar][foo\\!]\n\n[foo!]: /url\n",
        "expected": {
          "html": "<p>[bar][foo!]</p>"
        }
      },
      {
        "description": "example 546",
        "input": "[foo][ref[]\n\n[ref[]: /uri\n",
        "expected": {
          "html": "<p>[foo][ref[]</p>\n<p>[ref[]: /uri</p>"
        }
      },
      {
        "description": "example 547",
        "input": "[foo][ref[bar]]\n\n[ref[bar]]: /uri\n",
        "expected": {
          "html": "<p>[foo][ref[bar]]</p>\n<p>[ref[bar]]: /uri</p>"
        }
      },
      {
        "description": "example 548",
        "input": "[[[foo]]]\n\n[[[foo]]]: /url\n",
        "expected": {
          "html": "<p>[[[foo]]]</p>\n<p>[[[foo]]]: /url</p>"
        }
      },
      {
        "description": "example 549",
        "input": "[foo][ref\\[]\n\n[ref\\[]: /uri\n",
        "expected": {
          "html": "<p><a href=\"/uri\">foo</a></p>"
        }
      },
      {
        "description": "example 550",
        "input": "[bar\\\\]: /uri\n\n[bar\\\\]\n",
        "expected": {
          "html": "<p><a href=\"/uri\">bar\\</a></p>"
        }
      },
      {
        "description": "example 551",
        "input": "[]\n\n[]: /uri\n",
        "expected": {
          "html": "<p>[]</p>\n<p>[]: /uri</p>"
        }
      },
      {
        "description": "example 552",
        "input": "[\n ]\n\n[\n ]: /uri\n",
        "expected": {
          "html": "<p>[\n]</p>\n<p>[\n]: /uri</p>"
        }
      },
      {
        "description": "example 553",
        "input": "[foo][]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">foo</a></p>"
        }
      },
      {
        "description": "example 554",
        "input": "[*foo* bar][]\n\n[*foo* bar]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>"
        }
      },
      {
        "description": "example 555",
        "input": "[Foo][]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">Foo</a></p>"
        }
      },
      {
        "description": "example 556",
        "input": "[foo] \n[]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">foo</a>\n[]</p>"
        }
      },
      {
        "description": "example 557",
        "input": "[foo]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">foo</a></p>"
        }
      },
      {
        "description": "example 558",
        "input": "[*foo* bar]\n\n[*foo* bar]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>"
        }
      },
      {
        "description": "example 559",
        "input": "[[*foo* bar]]\n\n[*foo* bar]: /url \"title\"\n",
        "expected": {
          "html": "<p>[<a href=\"/url\" title=\"title\"><em>foo</em> bar</a>]</p>"
        }
      },
      {
        "description": "example 560",
        "input": "[[bar [foo]\n\n[foo]: /url\n",
        "expected": {
          "html": "<p>[[bar <a href=\"/url\">foo</a></p>"
        }
      },
      {
        "description": "example 561",
        "input": "[Foo]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p><a href=\"/url\" title=\"title\">Foo</a></p>"
        }
      },
      {
        "description": "example 562",
        "input": "[foo] bar\n\n[foo]: /url\n",
        "expected": {
          "html": "<p><a href=\"/url\">foo</a> bar</p>"
        }
      },
      {
        "description": "example 563",
        "input": "\\[foo]\n\n[foo]: /url \"title\"\n",
        "expected": {
          "html": "<p>[foo]</p>"
        }
      },
      {
        "description": "example 564",
        "input": "[foo*]: /url\n\n*[foo*]\n",
        "expected": {
          "html": "<p>*<a href=\"/url\">foo*</a></p>"
        }
      },
      {
        "description": "example 565",
        "input": "[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n",
        "expected": {
          "html": "<p><a href=\"/url2\">foo</a></p>"
        }
      },
      {
        "description": "example 566",
        "input": "[foo][]\n\n[foo]: /url1\n",
        "expected": {
          "html": "<p><a href=\"/url1\">foo</a></p>"
        }
      },
      {
        "description": "example 567",
        "input": "[foo]()\n\n[foo]: /url1\n",
        "expected": {
          "html": "<p><a href=\"\">foo</a></p>"
        }
      },
      {
        "description": "example 568",
        "input": "[foo](not a link)\n\n[foo]: /url1\n",
        "expected": {
          "html": "<p><a href=\"/url1\">foo</a>(not a link)</p>"
        }
      },
      {
        "description": "example 569",
        "input": "[foo][bar][baz]\n\n[baz]: /url\n",
        "expected": {
          "html": "<p>[foo]<a href=\"/url\">bar</a></p>"
        }
      },
      {
        "description": "example 570",
        "input": "[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n",
        "expected": {
          "html": "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>"
        }
      },
      {
        "description": "example 571",
        "input": "[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n",
        "expected": {
          "html": "<p>[foo]<a href=\"/url1\">bar</a></p>"
        }
      }
    ]
  }
]
