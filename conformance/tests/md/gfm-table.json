[
  {
    "description": "GFM spec: Tables",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm",
      "commit": "cd4e38f455e5872eefc83c9036ca621ba954cad8",
      "path": "test/spec.js",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      ["md.gfm"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 1",
        "input": "| foo | bar |\n| --- | --- |\n| baz | bim |\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>foo</th>\n<th>bar</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>baz</td>\n<td>bim</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "example 2",
        "input": "| abc | defghi |\n:-: | -----------:\nbar | baz\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th align=\"center\">abc</th>\n<th align=\"right\">defghi</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\">bar</td>\n<td align=\"right\">baz</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "example 3",
        "input": "| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>f|oo</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b <code>|</code> az</td>\n</tr>\n<tr>\n<td>b <strong>|</strong> im</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "example 4",
        "input": "| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>\n<blockquote>\n<p>bar</p>\n</blockquote>"
        }
      },
      {
        "description": "example 5",
        "input": "| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n<p>bar</p>"
        }
      },
      {
        "description": "example 6",
        "input": "| abc | def |\n| --- |\n| bar |\n",
        "expected": {
          "html": "<p>| abc | def |\n| --- |\n| bar |</p>"
        }
      },
      {
        "description": "example 7",
        "input": "| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>bar</td>\n<td></td>\n</tr>\n<tr>\n<td>bar</td>\n<td>baz</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "example 8",
        "input": "| abc | def |\n| --- | --- |\n",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>abc</th>\n<th>def</th>\n</tr>\n</thead>\n</table>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-table",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-table",
      "commit": "1511204dae5a01e81588cee417ecd4fb8d2c8aff",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.gfm"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should not support a table w/ the head row ending in an eof (1)",
        "input": "| a |",
        "expected": {
          "html": "<p>| a |</p>"
        }
      },
      {
        "description": "should not support a table w/ the head row ending in an eof (2)",
        "input": "| a",
        "expected": {
          "html": "<p>| a</p>"
        }
      },
      {
        "description": "should not support a table w/ the head row ending in an eof (3)",
        "input": "a |",
        "expected": {
          "html": "<p>a |</p>"
        }
      },
      {
        "description": "should support a table w/ a delimiter row ending in an eof (1)",
        "input": "| a |\n| - |",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support a table w/ a delimiter row ending in an eof (2)",
        "input": "| a\n| -",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support a table w/ a body row ending in an eof (1)",
        "input": "| a |\n| - |\n| b |",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support a table w/ a body row ending in an eof (2)",
        "input": "| a\n| -\n| b",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support a table w/ a body row ending in an eof (3)",
        "input": "a|b\n-|-\nc|d",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td>d</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support rows w/ trailing whitespace (1)",
        "input": "| a  \n| -\t\n| b |     ",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support rows w/ trailing whitespace (2)",
        "input": "| a | \n| - |",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support rows w/ trailing whitespace (3)",
        "input": "| a |\n| - | ",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support rows w/ trailing whitespace (4)",
        "input": "| a |\n| - |\n| b | ",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support empty first header cells",
        "input": "||a|\n|-|-|",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th></th>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support empty last header cells",
        "input": "|a||\n|-|-|",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th></th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support empty header cells",
        "input": "a||b\n-|-|-",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th></th>\n<th>b</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should support empty first body cells",
        "input": "|a|b|\n|-|-|\n||c|",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td></td>\n<td>c</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support empty last body cells",
        "input": "|a|b|\n|-|-|\n|c||",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>c</td>\n<td></td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support empty body cells",
        "input": "a|b|c\n-|-|-\nd||e",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n<th>c</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>d</td>\n<td></td>\n<td>e</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should support a list after a table",
        "input": "| a |\n| - |\n- b",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<ul>\n<li>b</li>\n</ul>"
        }
      },
      {
        "description": "should not support a lazy delimiter row (1)",
        "input": "> | a |\n| - |",
        "expected": {
          "html": "<blockquote>\n<p>| a |\n| - |</p>\n</blockquote>"
        }
      },
      {
        "description": "should not support a lazy delimiter row (2)",
        "input": "> a\n> | b |\n| - |",
        "expected": {
          "html": "<blockquote>\n<p>a\n| b |\n| - |</p>\n</blockquote>"
        }
      },
      {
        "description": "should not support a lazy delimiter row (3)",
        "input": "| a |\n> | - |",
        "expected": {
          "html": "<p>| a |</p>\n<blockquote>\n<p>| - |</p>\n</blockquote>"
        }
      },
      {
        "description": "should not support a lazy delimiter row (4)",
        "input": "> a\n> | b |\n|-",
        "expected": {
          "html": "<blockquote>\n<p>a\n| b |\n|-</p>\n</blockquote>"
        }
      },
      {
        "description": "should not support a lazy body row (1)",
        "input": "> | a |\n> | - |\n| b |",
        "expected": {
          "html": "<blockquote>\n<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n</blockquote>\n<p>| b |</p>"
        }
      },
      {
        "description": "should not support a lazy body row (2)",
        "input": "> a\n> | b |\n> | - |\n| c |",
        "expected": {
          "html": "<blockquote>\n<p>a</p>\n<table>\n<thead>\n<tr>\n<th>b</th>\n</tr>\n</thead>\n</table>\n</blockquote>\n<p>| c |</p>"
        }
      },
      {
        "description": "should not support a lazy body row (3)",
        "input": "> | A |\n> | - |\n> | 1 |\n| 2 |",
        "expected": {
          "html": "<blockquote>\n<table>\n<thead>\n<tr>\n<th>A</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n</tr>\n</tbody>\n</table>\n</blockquote>\n<p>| 2 |</p>"
        }
      },
      {
        "description": "should form a table if the delimiter row is indented w/ 3 spaces",
        "input": "| a |\n   | - |",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>"
        }
      },
      {
        "description": "should not form a table if the delimiter row is indented w/ 4 spaces",
        "input": "| a |\n    | - |",
        "expected": {
          "html": "<p>| a |\n| - |</p>"
        }
      },
      {
        "description": "should be interrupted by a block quote",
        "input": "| a |\n| - |\n> block quote?",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<blockquote>\n<p>block quote?</p>\n</blockquote>"
        }
      },
      {
        "description": "should be interrupted by a block quote (empty)",
        "input": "| a |\n| - |\n>",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<blockquote>\n</blockquote>"
        }
      },
      {
        "description": "should be interrupted by a list",
        "input": "| a |\n| - |\n- list?",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<ul>\n<li>list?</li>\n</ul>"
        }
      },
      {
        "description": "should be interrupted by a list (empty)",
        "input": "| a |\n| - |\n-",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<ul>\n<li></li>\n</ul>"
        }
      },
      {
        "description": "should be interrupted by a heading (ATX)",
        "input": "| a |\n| - |\n# heading?",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<h1>heading?</h1>"
        }
      },
      {
        "description": "should *not* be interrupted by a heading (setext)",
        "input": "| a |\n| - |\nheading\n=",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>heading</td>\n</tr>\n<tr>\n<td>=</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "should *not* be interrupted by a heading (setext), but interrupt if the underline is also a thematic break",
        "input": "| a |\n| - |\nheading\n---",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>heading</td>\n</tr>\n</tbody>\n</table>\n<hr>"
        }
      },
      {
        "description": "should *not* be interrupted by a heading (setext), but interrupt if the underline is also an empty list item bullet",
        "input": "| a |\n| - |\nheading\n-",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>heading</td>\n</tr>\n</tbody>\n</table>\n<ul>\n<li></li>\n</ul>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-table (dangerous HTML allowed)",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-table",
      "commit": "1511204dae5a01e81588cee417ecd4fb8d2c8aff",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.gfm"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should be interrupted by HTML (flow)",
        "input": "| a |\n| - |\n<!-- HTML? -->",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<!-- HTML? -->"
        }
      },
      {
        "description": "should be interrupted by code (indented)",
        "input": "| a |\n| - |\n\tcode?",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<pre><code>code?\n</code></pre>"
        }
      },
      {
        "description": "should be interrupted by code (fenced)",
        "input": "| a |\n| - |\n```js\ncode?",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<pre><code class=\"language-js\">code?\n</code></pre>"
        }
      },
      {
        "description": "should be interrupted by a thematic break",
        "input": "| a |\n| - |\n***",
        "expected": {
          "html": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<hr>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-table fixtures",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-table",
      "commit": "1511204dae5a01e81588cee417ecd4fb8d2c8aff",
      "path": "test/fixtures",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.gfm"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "fixture align",
        "input": "# Align\n\n## An empty initial cell\n\n| | a|c|\n|--|:----:|:---|\n|a|b|c|\n|a|b|c|\n\n## Missing alignment characters\n\n| a | b | c |\n|   |---|---|\n| d | e | f |\n\n* * *\n\n| a | b | c |\n|---|---|   |\n| d | e | f |\n\n## Incorrect characters\n\n| a | b | c |\n|---|-*-|---|\n| d | e | f |\n\n## Two alignments\n\n|a|\n|::|\n\n|a|\n|:-:|\n\n## Two at the start or end\n\n|a|\n|::-|\n\n|a|\n|-::|\n\n## In the middle\n\n|a|\n|-:-|\n\n## A space in the middle\n\n|a|\n|- -|\n\n## No pipe\n\na\n:-:\n\na\n:-\n\na\n-:\n\n## A single colon\n\n|a|\n|:|\n\na\n:\n\n## Alignment on empty cells\n\n| a | b | c | d | e |\n| - | - | :- | -: | :-: |\n| f |\n",
        "expected": {
          "html": "<h1>Align</h1>\n<h2>An empty initial cell</h2>\n<table>\n<thead>\n<tr>\n<th></th>\n<th align=\"center\">a</th>\n<th align=\"left\">c</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>a</td>\n<td align=\"center\">b</td>\n<td align=\"left\">c</td>\n</tr>\n<tr>\n<td>a</td>\n<td align=\"center\">b</td>\n<td align=\"left\">c</td>\n</tr>\n</tbody>\n</table>\n<h2>Missing alignment characters</h2>\n<p>| a | b | c |\n|   |---|---|\n| d | e | f |</p>\n<hr>\n<p>| a | b | c |\n|---|---|   |\n| d | e | f |</p>\n<h2>Incorrect characters</h2>\n<p>| a | b | c |\n|---|-*-|---|\n| d | e | f |</p>\n<h2>Two alignments</h2>\n<p>|a|\n|::|</p>\n<table>\n<thead>\n<tr>\n<th align=\"center\">a</th>\n</tr>\n</thead>\n</table>\n<h2>Two at the start or end</h2>\n<p>|a|\n|::-|</p>\n<p>|a|\n|-::|</p>\n<h2>In the middle</h2>\n<p>|a|\n|-:-|</p>\n<h2>A space in the middle</h2>\n<p>|a|\n|- -|</p>\n<h2>No pipe</h2>\n<table>\n<thead>\n<tr>\n<th align=\"center\">a</th>\n</tr>\n</thead>\n</table>\n<table>\n<thead>\n<tr>\n<th align=\"left\">a</th>\n</tr>\n</thead>\n</table>\n<table>\n<thead>\n<tr>\n<th align=\"right\">a</th>\n</tr>\n</thead>\n</table>\n<h2>A single colon</h2>\n<p>|a|\n|:|</p>\n<p>a\n:</p>\n<h2>Alignment on empty cells</h2>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n<th align=\"left\">c</th>\n<th align=\"right\">d</th>\n<th align=\"center\">e</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>f</td>\n<td></td>\n<td align=\"left\"></td>\n<td align=\"right\"></td>\n<td align=\"center\"></td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "fixture basic",
        "input": "# Tables\n\n| a | b | c |\n| - | - | - |\n| d | e | f |\n\n## No body\n\n| a | b | c |\n| - | - | - |\n\n## One column\n\n| a |\n| - |\n| b |\n",
        "expected": {
          "html": "<h1>Tables</h1>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n<th>c</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>d</td>\n<td>e</td>\n<td>f</td>\n</tr>\n</tbody>\n</table>\n<h2>No body</h2>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n<th>c</th>\n</tr>\n</thead>\n</table>\n<h2>One column</h2>\n<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>b</td>\n</tr>\n</tbody>\n</table>"
        }
      },
      {
        "description": "fixture containers",
