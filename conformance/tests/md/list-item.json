  {
    "description": "micromark document/list-item with dangerous HTML allowed",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/document/list-item.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should support HTML comments between lists",
        "input": "- foo\n- bar\n\n<!-- -->\n\n- baz\n- bim",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<!-- -->\n<ul>\n<li>baz</li>\n<li>bim</li>\n</ul>"
        }
      },
      {
        "description": "should support HTML comments between lists and indented code",
        "input": "-   foo\n\n    notcode\n\n-   foo\n\n<!-- -->\n\n    code",
        "expected": {
          "html": "<ul>\n<li>\n<p>foo</p>\n<p>notcode</p>\n</li>\n<li>\n<p>foo</p>\n</li>\n</ul>\n<!-- -->\n<pre><code>code\n</code></pre>"
        }
      },
      {
        "description": "should support the common list breaking comment method",
        "input": "* a\n\n<!---->\n\n* b",
        "expected": {
          "html": "<ul>\n<li>a</li>\n</ul>\n<!---->\n<ul>\n<li>b</li>\n</ul>"
        }
      }
    ]
  }
]
