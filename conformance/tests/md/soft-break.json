[
  {
    "description": "Soft line breaks",
    "specification": ["https://spec.commonmark.org/0.31.2/#soft-line-breaks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 648",
        "input": "foo\nbaz\n",
        "expected": {
          "html": "<p>foo\nbaz</p>"
        }
      },
      {
        "description": "example 649",
        "input": "foo \n baz\n",
        "expected": {
          "html": "<p>foo\nbaz</p>"
        }
      }
    ]
  },
  {
    "description": "Soft line breaks (tree)",
    "specification": ["https://spec.commonmark.org/0.31.2/#soft-line-breaks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"]],
    "tests": [
      {
        "description": "example 648",
        "input": "foo\nbaz\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "foo\nbaz",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 2,
                        "column": 4,
                        "offset": 7
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 2,
                    "column": 4,
                    "offset": 7
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 3,
                "column": 1,
                "offset": 8
              }
            }
          }
        }
      },
      {
        "description": "example 649",
        "input": "foo \n baz\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "foo\nbaz",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 2,
                        "column": 5,
                        "offset": 9
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 2,
                    "column": 5,
                    "offset": 9
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 3,
                "column": 1,
                "offset": 10
              }
            }
          }
        }
      }
    ]
  },
  {
    "description": "Soft line breaks (round trip)",
    "specification": ["https://spec.commonmark.org/0.31.2/#soft-line-breaks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"], ["md.stringify"]],
    "tests": [
      {
        "description": "example 648",
        "input": "foo\nbaz\n",
        "expected": {
          "md": "foo\nbaz\n"
        }
      },
      {
        "description": "example 649",
        "input": "foo \n baz\n",
        "expected": {
          "md": "foo\nbaz\n"
        }
      }
    ]
  },
  {
    "description": "micromark text/soft-break",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/soft-break.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support line endings",
        "input": "foo\nbaz",
        "expected": {
          "html": "<p>foo\nbaz</p>"
        }
      },
      {
        "description": "should trim spaces around line endings",
        "input": "foo \n baz",
        "expected": {
          "html": "<p>foo\nbaz</p>"
        }
      }
    ]
  }
]
