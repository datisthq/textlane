    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 42",
        "input": "- `one\n- two`\n",
        "expected": {
          "html": "<ul>\n<li>`one</li>\n<li>two`</li>\n</ul>"
        }
      }
    ]
  }
]
