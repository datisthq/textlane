  {
    "description": "mdast-util-gfm-task-list-item stringify",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-gfm-task-list-item",
      "commit": "ef2d59f69f6d0da6147b24af37f671a1b5a6803f",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [["md.gfm"], ["md.stringify"]],
    "tests": [
      {
        "description": "should serialize a checked list item",
        "tree": {
          "type": "listItem",
          "checked": true,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* [x] a\n"
        }
      },
      {
        "description": "should serialize an unchecked list item",
        "tree": {
          "type": "listItem",
          "checked": false,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "b"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* [ ] b\n"
        }
      },
      {
        "description": "should serialize an normal list item",
        "tree": {
          "type": "listItem",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "c"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* c\n"
        }
      },
      {
        "description": "should ignore `checked` if the head is not a paragraph",
        "tree": {
          "type": "listItem",
          "checked": true,
          "children": [
            {
              "type": "definition",
              "label": "d",
              "identifier": "d",
              "title": null,
              "url": "definition"
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "e"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* [d]: definition\n\n  e\n"
        }
      }
    ]
  },
