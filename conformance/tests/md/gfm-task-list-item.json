[
  {
    "description": "GFM spec: Task list items",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm",
      "commit": "cd4e38f455e5872eefc83c9036ca621ba954cad8",
      "path": "test/spec.js",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      ["md.gfm"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 9",
        "comment": "the GFM spec expects: <ul>\n<li><input disabled=\"\" type=\"checkbox\"> foo</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> bar</li>\n</ul>\n",
        "input": "- [ ] foo\n- [x] bar\n",
        "expected": {
          "html": "<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> foo</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> bar</li>\n</ul>"
        }
      },
      {
        "description": "example 10",
        "comment": "the GFM spec expects: <ul>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> foo\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> bar</li>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> baz</li>\n</ul>\n</li>\n<li><input disabled=\"\" type=\"checkbox\"> bim</li>\n</ul>\n",
        "input": "- [x] foo\n  - [ ] bar\n  - [x] baz\n- [ ] bim\n",
        "expected": {
          "html": "<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> foo\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> bar</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" checked disabled> baz</li>\n</ul>\n</li>\n<li class=\"task-list-item\"><input type=\"checkbox\" disabled> bim</li>\n</ul>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-task-list-item",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-task-list-item",
      "commit": "7902c38c76a6dea80928a54829313b702615d1e1",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.gfm"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should not support laziness (1)",
        "input": "*\n    [x]",
        "expected": {
          "html": "<ul>\n<li>[x]</li>\n</ul>"
        }
      },
      {
        "description": "should not support laziness (2)",
        "input": "*\n[x]",
        "expected": {
          "html": "<ul>\n<li></li>\n</ul>\n<p>[x]</p>"
        }
      }
    ]
  },
  {
