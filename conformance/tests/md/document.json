  {
    "description": "mdast-util-to-hast root",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-hast",
      "commit": "174795b21f7757fffb54dd8d5fb4012f4751f791",
      "path": "test/root.js",
      "license": "MIT"
    },
    "pipeline": [["md.toHtml"]],
    "tests": [
      {
        "description": "should map `root`s",
        "tree": {
          "type": "root",
          "children": []
        },
        "expected": {
          "tree": {
            "type": "root",
            "children": []
          }
        }
      },
      {
        "description": "should transform root nodes w/ `hName`",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "text",
              "value": "alpha"
            }
          ],
          "data": {
            "hName": "article"
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "article",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "alpha"
              }
            ]
          }
        }
      },
      {
        "description": "should transform root nodes w/ `hName`, `hProperties`",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "text",
              "value": "alpha"
            }
          ],
          "data": {
            "hName": "article",
            "hProperties": {
              "className": ["bravo"]
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "article",
            "properties": {
              "className": ["bravo"]
            },
            "children": [
              {
                "type": "text",
                "value": "alpha"
              }
            ]
          }
        }
      },
      {
        "description": "should transform root nodes w/ `hName`, `hChildren`",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "text",
              "value": "alpha"
            }
          ],
          "data": {
            "hName": "article",
            "hChildren": [
              {
                "type": "element",
                "tagName": "section",
                "properties": {},
                "children": [
                  {
                    "type": "text",
                    "value": "bravo"
                  }
                ]
              }
            ]
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "article",
            "properties": {},
            "children": [
              {
                "type": "element",
                "tagName": "section",
                "properties": {},
                "children": [
                  {
                    "type": "text",
                    "value": "bravo"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
]
