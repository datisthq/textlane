[
  {
    "description": "from-markdown",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-from-markdown",
      "commit": "afe9516d97683e51974694f944a799a915a242c0",
      "path": "test",
      "license": "MIT"
    },
    "pipeline": [["md.parse"]],
    "tests": [
      {
        "description": "fixture empty",
        "input": "",
        "expected": {
          "tree": {
            "type": "root",
            "children": [],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 1,
                "column": 1,
                "offset": 0
              }
            }
          }
        }
      }
    ]
  },
  {
    "description": "to-markdown core",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-markdown",
      "commit": "a31fe0608ff3c68f92f79bc5acc35235d8b69cee",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [["md.stringify"]],
    "tests": [
      {
        "description": "should support a `root`",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "thematicBreak"
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "b"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "a\n\n***\n\nb\n"
        }
      },
      {
        "description": "should not use blank lines between nodes when given phrasing",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "text",
              "value": "a"
            },
            {
              "type": "break"
            },
            {
              "type": "text",
              "value": "b"
            }
          ]
        },
        "expected": {
          "md": "a\\\nb\n"
        }
      },
      {
        "description": "should support adjacent definitions",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "definition",
              "identifier": "b",
              "url": ""
            },
            {
              "type": "definition",
              "identifier": "c",
              "url": ""
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "d"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "a\n\n[b]: <>\n\n[c]: <>\n\nd\n"
        }
      },
      {
        "description": "should use a different marker for adjacent lists",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "list",
              "children": [
                {
                  "type": "listItem",
                  "children": []
                }
              ]
            },
            {
              "type": "list",
              "children": [
                {
                  "type": "listItem",
                  "children": []
                }
              ]
            },
            {
              "type": "list",
              "ordered": true,
              "children": [
                {
                  "type": "listItem",
                  "children": []
                }
              ]
            },
            {
              "type": "list",
              "ordered": true,
              "children": [
                {
                  "type": "listItem",
                  "children": []
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "d"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "a\n\n*\n\n-\n\n1.\n\n1)\n\nd\n"
        }
      },
      {
        "description": "should not honour `spread: false` for two paragraphs",
        "tree": {
          "type": "listItem",
          "spread": false,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "b"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* a\n\n  b\n"
        }
      },
      {
        "description": "should not honour `spread: false` for a paragraph and a definition",
        "tree": {
          "type": "listItem",
          "spread": false,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "definition",
              "identifier": "b",
              "label": "c",
              "url": "d"
            }
          ]
        },
        "expected": {
          "md": "* a\n\n  [c]: d\n"
        }
      },
      {
        "description": "should honour `spread: false` for a paragraph and a heading",
        "tree": {
          "type": "listItem",
          "spread": false,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "heading",
              "depth": 1,
              "children": [
                {
                  "type": "text",
                  "value": "b"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* a\n  # b\n"
        }
      }
    ]
  },
  {
    "description": "to-markdown core {\"tightDefinitions\":true}",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-markdown",
      "commit": "a31fe0608ff3c68f92f79bc5acc35235d8b69cee",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "md.stringify",
        {
          "tightDefinitions": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should support tight adjacent definitions when `tightDefinitions: true`",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "definition",
              "identifier": "b",
              "url": ""
            },
            {
              "type": "definition",
              "identifier": "c",
              "url": ""
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "d"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "a\n\n[b]: <>\n[c]: <>\n\nd\n"
        }
      }
    ]
  },
  {
    "description": "to-markdown core {\"fences\":false}",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-markdown",
      "commit": "a31fe0608ff3c68f92f79bc5acc35235d8b69cee",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "md.stringify",
        {
          "fences": false
        }
      ]
    ],
    "tests": [
      {
        "description": "should inject HTML comments between lists and an indented code",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "code",
              "value": "a"
            },
            {
              "type": "list",
              "children": [
                {
                  "type": "listItem",
                  "children": []
                }
              ]
            },
            {
              "type": "code",
              "value": "b"
            }
          ]
        },
        "expected": {
          "md": "    a\n\n*\n\n<!---->\n\n    b\n"
        }
      },
      {
        "description": "should inject HTML comments between adjacent indented code",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "code",
              "value": "a"
            },
            {
              "type": "code",
              "value": "b"
            }
          ]
        },
        "expected": {
          "md": "    a\n\n<!---->\n\n    b\n"
        }
      }
    ]
  },
  {
    "description": "to-markdown core {\"setext\":true}",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-markdown",
      "commit": "a31fe0608ff3c68f92f79bc5acc35235d8b69cee",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "md.stringify",
        {
          "setext": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should not honour `spread: false` for a paragraph and a setext heading",
        "tree": {
          "type": "listItem",
          "spread": false,
          "children": [
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "a"
                }
              ]
            },
            {
              "type": "heading",
              "depth": 1,
              "children": [
                {
                  "type": "text",
                  "value": "b"
                }
              ]
            }
          ]
        },
        "expected": {
          "md": "* a\n\n  b\n  =\n"
        }
      }
    ]
  },
  {
    "description": "mdast-util-to-hast core",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-hast",
      "commit": "174795b21f7757fffb54dd8d5fb4012f4751f791",
      "path": "test/core.js",
      "license": "MIT"
    },
    "pipeline": [["md.toHtml"]],
    "tests": [
      {
        "description": "should prefer `data.hName` to tag names",
        "tree": {
          "type": "strong",
          "data": {
            "hName": "b"
          },
          "children": [
            {
              "type": "text",
              "value": "alpha"
            }
          ]
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "b",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "alpha"
              }
            ]
          }
        }
      },
      {
        "description": "should support `data.hProperties`",
        "tree": {
          "type": "strong",
          "data": {
            "hProperties": {
              "title": "delta"
            }
          },
          "children": [
            {
              "type": "text",
              "value": "echo"
            }
          ]
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "strong",
            "properties": {
              "title": "delta"
            },
            "children": [
              {
                "type": "text",
                "value": "echo"
              }
            ]
          }
        }
      },
      {
        "description": "should patch `position`s when given",
        "tree": {
          "type": "emphasis",
          "children": [
            {
              "type": "text",
              "value": "foxtrot"
            }
          ],
          "position": {
            "start": {
              "line": 2,
              "column": 3
            },
            "end": {
              "line": 2,
              "column": 12
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "em",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "foxtrot"
              }
            ],
            "position": {
              "start": {
                "line": 2,
                "column": 3
              },
              "end": {
                "line": 2,
                "column": 12
              }
            }
          }
        }
      },
      {
        "description": "should patch `position`s on `pre` and `code`",
        "tree": {
          "type": "code",
          "value": "golf",
          "position": {
            "start": {
              "line": 2,
              "column": 3
            },
            "end": {
              "line": 2,
              "column": 12
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "pre",
            "properties": {},
            "children": [
              {
                "type": "element",
                "tagName": "code",
                "properties": {},
                "children": [
                  {
                    "type": "text",
                    "value": "golf\n"
                  }
                ],
                "position": {
                  "start": {
                    "line": 2,
                    "column": 3
                  },
                  "end": {
                    "line": 2,
                    "column": 12
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 2,
                "column": 3
              },
              "end": {
                "line": 2,
                "column": 12
              }
            }
          }
        }
      },
      {
        "description": "should patch `position`s when given (2)",
        "tree": {
          "type": "emphasis",
          "children": [
            {
              "type": "text",
              "value": "foxtrot"
            }
          ],
          "position": {
            "start": {
              "line": 2,
              "column": 3
            },
            "end": {
              "line": 2,
              "column": 12
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "em",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "foxtrot"
              }
            ],
            "position": {
              "start": {
                "line": 2,
                "column": 3
              },
              "end": {
                "line": 2,
                "column": 12
              }
            }
          }
        }
      },
      {
        "description": "should patch `position`s on `pre` and `code` (2)",
        "tree": {
          "type": "code",
          "value": "golf",
          "position": {
            "start": {
              "line": 2,
              "column": 3
            },
            "end": {
              "line": 2,
              "column": 12
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "pre",
            "properties": {},
            "children": [
              {
                "type": "element",
                "tagName": "code",
                "properties": {},
                "children": [
                  {
                    "type": "text",
                    "value": "golf\n"
                  }
                ],
                "position": {
                  "start": {
                    "line": 2,
                    "column": 3
                  },
                  "end": {
                    "line": 2,
                    "column": 12
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 2,
                "column": 3
              },
              "end": {
                "line": 2,
                "column": 12
              }
            }
          }
        }
      },
      {
        "description": "should transform unknown texts to `text`",
        "tree": {
          "type": "hotel",
          "value": "india"
        },
        "expected": {
          "tree": {
            "type": "text",
            "value": "india"
          }
        }
      },
      {
        "description": "should transform unknown parents to `div`",
        "tree": {
          "type": "juliett",
          "children": [
            {
              "type": "text",
              "value": "kilo"
            }
          ]
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "div",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "kilo"
              }
            ]
          }
        }
      },
      {
        "description": "should transform unknown voids to `div`",
        "tree": {
          "type": "lima"
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "div",
            "properties": {},
            "children": []
          }
        }
      },
      {
        "description": "should transform unknown nodes with `data.h*` properties",
        "tree": {
          "type": "mike",
          "data": {
            "hName": "code",
            "hProperties": {
              "className": ["november"]
            },
            "hChildren": [
              {
                "type": "text",
                "value": "oscar"
              }
            ]
          },
          "value": "papa"
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "code",
            "properties": {
              "className": ["november"]
            },
            "children": [
              {
                "type": "text",
                "value": "oscar"
              }
            ]
          }
        }
      },
      {
        "description": "should transform unknown nodes with `data.hChildren` only to `div`",
        "tree": {
          "type": "quebec",
          "data": {
            "hChildren": [
              {
                "type": "text",
                "value": "romeo"
              }
            ]
          },
          "value": "sierra"
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "div",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "romeo"
              }
            ]
          }
        }
      },
      {
        "description": "should transform unknown nodes with `data.hProperties` only to a `element` node",
        "tree": {
          "type": "tango",
          "data": {
            "hProperties": {
              "className": ["uniform"]
            }
          },
          "value": "whiskey"
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "div",
            "properties": {
              "className": ["uniform"]
            },
            "children": []
          }
        }
      },
      {
        "description": "should support unknown nodes by default",
        "tree": {
          "type": "paragraph",
          "children": [
            {
              "type": "alpha",
              "value": "alpha"
            },
            {
              "type": "bravo",
              "children": [
                {
                  "type": "image",
                  "url": "bravo"
                }
              ]
            },
            {
              "type": "text",
              "value": "charlie"
            }
          ]
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "p",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "alpha"
              },
              {
                "type": "element",
                "tagName": "div",
                "properties": {},
                "children": [
                  {
                    "type": "element",
                    "tagName": "img",
                    "properties": {
                      "src": "bravo"
                    },
                    "children": []
                  }
                ]
              },
              {
                "type": "text",
                "value": "charlie"
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "mdast-util-to-hast core {\"passThrough\":[\"alpha\",\"bravo\"]}",
    "source": {
