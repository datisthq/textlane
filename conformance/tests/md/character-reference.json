[
  {
    "description": "Entity and numeric character references",
    "specification": [
      "https://spec.commonmark.org/0.31.2/#entity-and-numeric-character-references"
    ],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 25",
        "input": "&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertSpace; &DifferentialD;\n&ClockwiseContourIntegral; &ngE;\n",
        "expected": {
          "html": "<p>  &#x26; © Æ Ď\n¾ ℋ ⅆ\n∲ ≧̸</p>"
        }
      },
      {
        "description": "example 26",
        "input": "&#35; &#1234; &#992; &#0;\n",
        "expected": {
          "html": "<p># Ӓ Ϡ �</p>"
        }
      },
      {
        "description": "example 27",
        "input": "&#X22; &#XD06; &#xcab;\n",
        "expected": {
          "html": "<p>\" ആ ಫ</p>"
        }
      },
      {
        "description": "example 28",
        "input": "&nbsp &x; &#; &#x;\n&#87654321;\n&#abcdef0;\n&ThisIsNotDefined; &hi?;\n",
        "expected": {
          "html": "<p>&#x26;nbsp &#x26;x; &#x26;#; &#x26;#x;\n&#x26;#87654321;\n&#x26;#abcdef0;\n&#x26;ThisIsNotDefined; &#x26;hi?;</p>"
        }
      },
      {
        "description": "example 29",
        "input": "&copy\n",
        "expected": {
          "html": "<p>&#x26;copy</p>"
        }
      },
      {
        "description": "example 30",
        "input": "&MadeUpEntity;\n",
        "expected": {
          "html": "<p>&#x26;MadeUpEntity;</p>"
        }
      },
      {
        "description": "example 31",
        "input": "<a href=\"&ouml;&ouml;.html\">\n",
        "expected": {
          "html": "<a href=\"&ouml;&ouml;.html\">"
        }
      },
      {
        "description": "example 32",
        "input": "[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\")\n",
        "expected": {
          "html": "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>"
        }
      },
      {
        "description": "example 33",
        "input": "[foo]\n\n[foo]: /f&ouml;&ouml; \"f&ouml;&ouml;\"\n",
        "expected": {
          "html": "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>"
        }
      },
      {
        "description": "example 34",
        "input": "``` f&ouml;&ouml;\nfoo\n```\n",
        "expected": {
          "html": "<pre><code class=\"language-föö\">foo\n</code></pre>"
        }
      },
      {
        "description": "example 35",
        "input": "`f&ouml;&ouml;`\n",
        "expected": {
          "html": "<p><code>f&#x26;ouml;&#x26;ouml;</code></p>"
        }
      },
      {
        "description": "example 36",
        "input": "    f&ouml;f&ouml;\n",
        "expected": {
          "html": "<pre><code>f&#x26;ouml;f&#x26;ouml;\n</code></pre>"
        }
      },
      {
        "description": "example 37",
        "input": "&#42;foo&#42;\n*foo*\n",
        "expected": {
          "html": "<p>*foo*\n<em>foo</em></p>"
        }
      },
      {
        "description": "example 38",
        "input": "&#42; foo\n\n* foo\n",
        "expected": {
          "html": "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>"
        }
      },
      {
        "description": "example 39",
        "input": "foo&#10;&#10;bar\n",
        "expected": {
          "html": "<p>foo\n\nbar</p>"
        }
      },
      {
        "description": "example 40",
        "input": "&#9;foo\n",
        "expected": {
          "html": "<p>\tfoo</p>"
        }
      },
      {
        "description": "example 41",
        "input": "[a](url &quot;tit&quot;)\n",
        "expected": {
          "html": "<p>[a](url \"tit\")</p>"
        }
      }
    ]
  },
  {
    "description": "micromark text/character-reference",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/character-reference.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support decimal character references",
        "input": "&#35; &#1234; &#992; &#0;",
        "expected": {
          "html": "<p># Ӓ Ϡ �</p>"
        }
      },
      {
        "description": "should support hexadecimal character references",
        "input": "&#X22; &#XD06; &#xcab;",
        "expected": {
          "html": "<p>\" ആ ಫ</p>"
        }
      },
      {
        "description": "should support astral character references",
        "input": "片&#xE0103;",
        "expected": {
          "html": "<p>片󠄃</p>"
        }
      },
      {
        "description": "should not support character references w/o semicolon",
        "input": "&copy",
        "expected": {
          "html": "<p>&#x26;copy</p>"
        }
      },
      {
        "description": "should not support unknown named character references",
        "input": "&MadeUpEntity;",
        "expected": {
          "html": "<p>&#x26;MadeUpEntity;</p>"
        }
      },
      {
        "description": "should support character references in resource URLs and titles",
        "input": "[foo](/f&ouml;&ouml; \"f&ouml;&ouml;\")",
        "expected": {
          "html": "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>"
        }
      },
      {
        "description": "should support character references in definition URLs and titles",
        "input": "[foo]: /f&ouml;&ouml; \"f&ouml;&ouml;\"\n\n[foo]",
        "expected": {
          "html": "<p><a href=\"/f%C3%B6%C3%B6\" title=\"föö\">foo</a></p>"
        }
      },
      {
        "description": "should support character references in code language",
        "input": "``` f&ouml;&ouml;\nfoo\n```",
        "expected": {
          "html": "<pre><code class=\"language-föö\">foo\n</code></pre>"
        }
      },
      {
        "description": "should not support character references in text code",
        "input": "`f&ouml;&ouml;`",
        "expected": {
          "html": "<p><code>f&#x26;ouml;&#x26;ouml;</code></p>"
        }
      },
      {
        "description": "should not support character references in indented code",
        "input": "    f&ouml;f&ouml;",
        "expected": {
          "html": "<pre><code>f&#x26;ouml;f&#x26;ouml;\n</code></pre>"
        }
      },
      {
        "description": "should not support character references as construct markers (1)",
        "input": "&#42;foo&#42;\n*foo*",
        "expected": {
          "html": "<p>*foo*\n<em>foo</em></p>"
        }
      },
      {
        "description": "should not support character references as construct markers (2)",
        "input": "&#42; foo\n\n* foo",
        "expected": {
          "html": "<p>* foo</p>\n<ul>\n<li>foo</li>\n</ul>"
        }
      },
      {
        "description": "should not support character references as construct markers (3)",
        "input": "[a](url &quot;tit&quot;)",
        "expected": {
          "html": "<p>[a](url \"tit\")</p>"
        }
      },
      {
        "description": "should not support character references as whitespace (1)",
        "input": "foo&#10;&#10;bar",
        "expected": {
          "html": "<p>foo\n\nbar</p>"
        }
      },
      {
        "description": "should not support character references as whitespace (2)",
        "input": "&#9;foo",
        "expected": {
          "html": "<p>\tfoo</p>"
        }
      },
      {
        "description": "should support the longest possible named character reference",
        "input": "&CounterClockwiseContourIntegral;",
        "expected": {
          "html": "<p>∳</p>"
        }
      },
      {
        "description": "should “support” a longest possible hexadecimal character reference",
        "input": "&#xff9999;",
        "expected": {
          "html": "<p>�</p>"
        }
      },
      {
        "description": "should “support” a longest possible decimal character reference",
        "input": "&#9999999;",
        "expected": {
          "html": "<p>�</p>"
        }
      },
      {
        "description": "should not support the longest possible named character reference",
        "input": "&CounterClockwiseContourIntegrali;",
        "expected": {
          "html": "<p>&#x26;CounterClockwiseContourIntegrali;</p>"
        }
      },
      {
        "description": "should not support a longest possible hexadecimal character reference",
        "input": "&#xff99999;",
        "expected": {
          "html": "<p>&#x26;#xff99999;</p>"
        }
      },
      {
        "description": "should not support a longest possible decimal character reference",
        "input": "&#99999999;",
        "expected": {
          "html": "<p>&#x26;#99999999;</p>"
        }
      },
      {
        "description": "should not support the other characters after `&`",
        "input": "&-;",
        "expected": {
          "html": "<p>&#x26;-;</p>"
        }
      },
      {
        "description": "should not support the other characters after `#`",
        "input": "&#-;",
        "expected": {
          "html": "<p>&#x26;#-;</p>"
        }
      },
      {
        "description": "should not support the other characters after `#x`",
        "input": "&#x-;",
        "expected": {
          "html": "<p>&#x26;#x-;</p>"
        }
      },
      {
        "description": "should not support the other characters inside a name",
        "input": "&lt-;",
        "expected": {
          "html": "<p>&#x26;lt-;</p>"
        }
      },
      {
        "description": "should not support the other characters inside a demical",
        "input": "&#9-;",
        "expected": {
          "html": "<p>&#x26;#9-;</p>"
        }
      },
      {
        "description": "should not support the other characters inside a hexademical",
        "input": "&#x9-;",
        "expected": {
          "html": "<p>&#x26;#x9-;</p>"
        }
      }
    ]
  },
  {
    "description": "micromark text/character-reference with dangerous HTML allowed",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/character-reference.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should not care about character references in html",
        "input": "<a href=\"&ouml;&ouml;.html\">",
        "expected": {
          "html": "<a href=\"&ouml;&ouml;.html\">"
        }
      }
    ]
  }
]
