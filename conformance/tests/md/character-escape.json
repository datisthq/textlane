  {
    "description": "micromark text/character-escape",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/character-escape.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support escaped ascii punctuation",
        "input": "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~",
        "expected": {
          "html": "<p>!\"#$%&#x26;'()*+,-./:;&#x3C;=>?@[\\]^_`{|}~</p>"
        }
      },
      {
        "description": "should not support other characters after a backslash",
        "input": "\\→\\A\\a\\ \\3\\φ\\«",
        "expected": {
          "html": "<p>\\→\\A\\a\\ \\3\\φ\\«</p>"
        }
      },
      {
        "description": "should escape other constructs",
        "input": "\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity",
        "expected": {
          "html": "<p>*not emphasized*\n&#x3C;br/> not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url \"not a reference\"\n&#x26;ouml; not a character entity</p>"
        }
      },
      {
        "description": "should escape a line break",
        "input": "foo\\\nbar",
        "expected": {
          "html": "<p>foo<br>\nbar</p>"
        }
      },
      {
        "description": "should not escape in text code",
        "input": "`` \\[\\` ``",
        "expected": {
          "html": "<p><code>\\[\\`</code></p>"
        }
      },
      {
        "description": "should not escape in indented code",
        "input": "    \\[\\]",
        "expected": {
          "html": "<pre><code>\\[\\]\n</code></pre>"
        }
      },
      {
        "description": "should not escape in autolink",
        "input": "<http://example.com?find=\\*>",
        "expected": {
          "html": "<p><a href=\"http://example.com?find=%5C*\">http://example.com?find=\\*</a></p>"
        }
      },
      {
        "description": "should escape in resource and title",
        "input": "[foo](/bar\\* \"ti\\*tle\")",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "should escape in definition resource and title",
        "input": "[foo]: /bar\\* \"ti\\*tle\"\n\n[foo]",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "should escape in fenced code info",
