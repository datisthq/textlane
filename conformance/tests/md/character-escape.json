[
  {
    "description": "Backslash escapes",
    "specification": ["https://spec.commonmark.org/0.31.2/#backslash-escapes"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 12",
        "input": "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~\n",
        "expected": {
          "html": "<p>!\"#$%&#x26;'()*+,-./:;&#x3C;=>?@[\\]^_`{|}~</p>"
        }
      },
      {
        "description": "example 13",
        "input": "\\\t\\A\\a\\ \\3\\φ\\«\n",
        "expected": {
          "html": "<p>\\\t\\A\\a\\ \\3\\φ\\«</p>"
        }
      },
      {
        "description": "example 14",
        "input": "\\*not emphasized*\n\\<br/> not a tag\n\\[not a link](/foo)\n\\`not code`\n1\\. not a list\n\\* not a list\n\\# not a heading\n\\[foo]: /url \"not a reference\"\n\\&ouml; not a character entity\n",
        "expected": {
          "html": "<p>*not emphasized*\n&#x3C;br/> not a tag\n[not a link](/foo)\n`not code`\n1. not a list\n* not a list\n# not a heading\n[foo]: /url \"not a reference\"\n&#x26;ouml; not a character entity</p>"
        }
      },
      {
        "description": "example 15",
        "input": "\\\\*emphasis*\n",
        "expected": {
          "html": "<p>\\<em>emphasis</em></p>"
        }
      },
      {
        "description": "example 16",
        "input": "foo\\\nbar\n",
        "expected": {
          "html": "<p>foo<br>\nbar</p>"
        }
      },
      {
        "description": "example 17",
        "input": "`` \\[\\` ``\n",
        "expected": {
          "html": "<p><code>\\[\\`</code></p>"
        }
      },
      {
        "description": "example 18",
        "input": "    \\[\\]\n",
        "expected": {
          "html": "<pre><code>\\[\\]\n</code></pre>"
        }
      },
      {
        "description": "example 19",
        "input": "~~~\n\\[\\]\n~~~\n",
        "expected": {
          "html": "<pre><code>\\[\\]\n</code></pre>"
        }
      },
      {
        "description": "example 20",
        "input": "<https://example.com?find=\\*>\n",
        "expected": {
          "html": "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>"
        }
      },
      {
        "description": "example 21",
        "input": "<a href=\"/bar\\/)\">\n",
        "expected": {
          "html": "<a href=\"/bar\\/)\">"
        }
      },
      {
        "description": "example 22",
        "input": "[foo](/bar\\* \"ti\\*tle\")\n",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "example 23",
        "input": "[foo]\n\n[foo]: /bar\\* \"ti\\*tle\"\n",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "example 24",
        "input": "``` foo\\+bar\nfoo\n```\n",
        "expected": {
          "html": "<pre><code class=\"language-foo+bar\">foo\n</code></pre>"
        }
      }
    ]
  },
  {
    "description": "micromark text/character-escape",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/character-escape.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support escaped ascii punctuation",
        "input": "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~",
        "expected": {
          "html": "<p>!\"#$%&#x26;'()*+,-./:;&#x3C;=>?@[\\]^_`{|}~</p>"
        }
      },
      {
        "description": "should not support other characters after a backslash",
        "input": "\\→\\A\\a\\ \\3\\φ\\«",
        "expected": {
          "html": "<p>\\→\\A\\a\\ \\3\\φ\\«</p>"
        }
      },
      {
        "description": "should escape a line break",
        "input": "foo\\\nbar",
        "expected": {
          "html": "<p>foo<br>\nbar</p>"
        }
      },
      {
        "description": "should not escape in text code",
        "input": "`` \\[\\` ``",
        "expected": {
          "html": "<p><code>\\[\\`</code></p>"
        }
      },
      {
        "description": "should not escape in indented code",
        "input": "    \\[\\]",
        "expected": {
          "html": "<pre><code>\\[\\]\n</code></pre>"
        }
      },
      {
        "description": "should not escape in autolink",
        "input": "<http://example.com?find=\\*>",
        "expected": {
          "html": "<p><a href=\"http://example.com?find=%5C*\">http://example.com?find=\\*</a></p>"
        }
      },
      {
        "description": "should escape in resource and title",
        "input": "[foo](/bar\\* \"ti\\*tle\")",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "should escape in definition resource and title",
        "input": "[foo]: /bar\\* \"ti\\*tle\"\n\n[foo]",
        "expected": {
          "html": "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>"
        }
      },
      {
        "description": "should escape in fenced code info",
        "input": "``` foo\\+bar\nfoo\n```",
        "expected": {
          "html": "<pre><code class=\"language-foo+bar\">foo\n</code></pre>"
        }
      }
    ]
  },
  {
    "description": "micromark text/character-escape with dangerous HTML allowed",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/character-escape.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should not escape in flow html",
        "input": "<a href=\"/bar\\/)\">",
        "expected": {
          "html": "<a href=\"/bar\\/)\">"
        }
      }
    ]
  }
]
