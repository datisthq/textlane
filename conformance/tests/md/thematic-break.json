[
  {
    "description": "Thematic breaks",
    "specification": ["https://spec.commonmark.org/0.31.2/#thematic-breaks"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 43",
        "input": "***\n---\n___\n",
        "expected": {
          "html": "<hr>\n<hr>\n<hr>"
        }
      },
      {
        "description": "example 44",
        "input": "+++\n",
        "expected": {
          "html": "<p>+++</p>"
        }
      },
      {
        "description": "example 45",
        "input": "===\n",
        "expected": {
          "html": "<p>===</p>"
        }
      },
      {
        "description": "example 46",
        "input": "--\n**\n__\n",
        "expected": {
          "html": "<p>--\n**\n__</p>"
        }
      },
      {
        "description": "example 47",
        "input": " ***\n  ***\n   ***\n",
        "expected": {
          "html": "<hr>\n<hr>\n<hr>"
        }
      },
      {
        "description": "example 48",
        "input": "    ***\n",
        "expected": {
          "html": "<pre><code>***\n</code></pre>"
        }
      },
      {
        "description": "example 49",
        "input": "Foo\n    ***\n",
        "expected": {
          "html": "<p>Foo\n***</p>"
        }
      },
      {
        "description": "example 50",
        "input": "_____________________________________\n",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "example 51",
        "input": " - - -\n",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "example 52",
        "input": " **  * ** * ** * **\n",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "example 53",
        "input": "-     -      -      -\n",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "example 54",
        "input": "- - - -    \n",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "example 55",
        "input": "_ _ _ _ a\n\na------\n\n---a---\n",
        "expected": {
          "html": "<p>_ _ _ _ a</p>\n<p>a------</p>\n<p>---a---</p>"
        }
      },
      {
        "description": "example 56",
        "input": " *-*\n",
        "expected": {
          "html": "<p><em>-</em></p>"
        }
      },
      {
        "description": "example 57",
        "input": "- foo\n***\n- bar\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n</ul>\n<hr>\n<ul>\n<li>bar</li>\n</ul>"
        }
      },
      {
        "description": "example 58",
        "input": "Foo\n***\nbar\n",
        "expected": {
          "html": "<p>Foo</p>\n<hr>\n<p>bar</p>"
        }
      },
      {
        "description": "example 59",
        "input": "Foo\n---\nbar\n",
        "expected": {
          "html": "<h2>Foo</h2>\n<p>bar</p>"
        }
      },
      {
        "description": "example 60",
        "input": "* Foo\n* * *\n* Bar\n",
        "expected": {
          "html": "<ul>\n<li>Foo</li>\n</ul>\n<hr>\n<ul>\n<li>Bar</li>\n</ul>"
        }
      },
      {
        "description": "example 61",
        "input": "- Foo\n- * * *\n",
        "expected": {
          "html": "<ul>\n<li>Foo</li>\n<li>\n<hr>\n</li>\n</ul>"
        }
      }
    ]
  },
  {
    "description": "micromark flow/thematic-break",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/flow/thematic-break.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support thematic breaks w/ asterisks, dashes, and underscores",
        "input": "***\n---\n___",
        "expected": {
          "html": "<hr>\n<hr>\n<hr>"
        }
      },
      {
        "description": "should not support thematic breaks w/ plusses",
        "input": "+++",
        "expected": {
          "html": "<p>+++</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ equals",
        "input": "===",
        "expected": {
          "html": "<p>===</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ two dashes",
        "input": "--",
        "expected": {
          "html": "<p>--</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ two asterisks",
        "input": "**",
        "expected": {
          "html": "<p>**</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ two underscores",
        "input": "__",
        "expected": {
          "html": "<p>__</p>"
        }
      },
      {
        "description": "should support thematic breaks w/ 1 space",
        "input": " ***",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ 2 spaces",
        "input": "  ***",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ 3 spaces",
        "input": "   ***",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should not support thematic breaks w/ 4 spaces",
        "input": "    ***",
        "expected": {
          "html": "<pre><code>***\n</code></pre>"
        }
      },
      {
        "description": "should not support thematic breaks w/ 4 spaces as paragraph continuation",
        "input": "Foo\n    ***",
        "expected": {
          "html": "<p>Foo\n***</p>"
        }
      },
      {
        "description": "should support thematic breaks w/ many markers",
        "input": "_____________________________________",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ spaces (1)",
        "input": " - - -",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ spaces (2)",
        "input": " **  * ** * ** * **",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ spaces (3)",
        "input": "-     -      -      -",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should support thematic breaks w/ trailing spaces",
        "input": "- - - -    ",
        "expected": {
          "html": "<hr>"
        }
      },
      {
        "description": "should not support thematic breaks w/ other characters (1)",
        "input": "_ _ _ _ a",
        "expected": {
          "html": "<p>_ _ _ _ a</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ other characters (2)",
        "input": "a------",
        "expected": {
          "html": "<p>a------</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ other characters (3)",
        "input": "---a---",
        "expected": {
          "html": "<p>---a---</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ mixed markers",
        "input": " *-*",
        "expected": {
          "html": "<p><em>-</em></p>"
        }
      },
      {
        "description": "should support thematic breaks mixed w/ lists (1)",
        "input": "- foo\n***\n- bar",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n</ul>\n<hr>\n<ul>\n<li>bar</li>\n</ul>"
        }
      },
      {
        "description": "should support thematic breaks mixed w/ lists (2)",
        "input": "* Foo\n* * *\n* Bar",
        "expected": {
          "html": "<ul>\n<li>Foo</li>\n</ul>\n<hr>\n<ul>\n<li>Bar</li>\n</ul>"
        }
      },
      {
        "description": "should support thematic breaks interrupting paragraphs",
        "input": "Foo\n***\nbar",
        "expected": {
          "html": "<p>Foo</p>\n<hr>\n<p>bar</p>"
        }
      },
      {
        "description": "should not support thematic breaks w/ dashes interrupting paragraphs (setext heading)",
        "input": "Foo\n---\nbar",
        "expected": {
          "html": "<h2>Foo</h2>\n<p>bar</p>"
        }
      },
      {
        "description": "should support thematic breaks in lists",
        "input": "- Foo\n- * * *",
        "expected": {
          "html": "<ul>\n<li>Foo</li>\n<li>\n<hr>\n</li>\n</ul>"
        }
      },
      {
        "description": "should not support lazyness (1)",
        "input": "> ---\na",
        "expected": {
          "html": "<blockquote>\n<hr>\n</blockquote>\n<p>a</p>"
        }
      }
    ]
  }
]
