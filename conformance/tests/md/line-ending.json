[
  {
    "description": "micromark misc/line-ending",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/misc/line-ending.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support a line feed for a line ending inside a paragraph",
        "input": "a\nb",
        "expected": {
          "html": "<p>a\nb</p>"
        }
      },
      {
        "description": "should support a carriage return for a line ending inside a paragraph",
        "input": "a\rb",
        "expected": {
          "html": "<p>a\rb</p>"
        }
      },
      {
        "description": "should support a carriage return + line feed for a line ending inside a paragraph",
        "input": "a\r\nb",
        "expected": {
          "html": "<p>a\r\nb</p>"
        }
      },
      {
        "description": "should support a line feed in indented code (and prefer it)",
        "input": "\ta\n\tb",
        "expected": {
          "html": "<pre><code>a\nb\n</code></pre>"
        }
      },
      {
        "description": "should support a carriage return in indented code (and prefer it)",
        "input": "\ta\r\tb",
        "expected": {
          "html": "<pre><code>a\rb\n</code></pre>"
        }
      },
      {
        "description": "should support a carriage return + line feed in indented code (and prefer it)",
        "input": "\ta\r\n\tb",
        "expected": {
          "html": "<pre><code>a\r\nb\n</code></pre>"
        }
      },
      {
        "description": "should support a line feed between flow",
        "input": "***\n### Heading",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support a carriage return between flow",
        "input": "***\r### Heading",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support a carriage return + line feed between flow",
        "input": "***\r\n### Heading",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support several line feeds between flow",
        "input": "***\n\n\n### Heading\n",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support several carriage returns between flow",
        "comment": "micromark renders: <hr />\r<h3>Heading</h3>\r",
        "input": "***\r\r\r### Heading\r",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support several carriage return + line feeds between flow",
        "comment": "micromark renders: <hr />\r\n<h3>Heading</h3>\r\n",
        "input": "***\r\n\r\n\r\n### Heading\r\n",
        "expected": {
          "html": "<hr>\n<h3>Heading</h3>"
        }
      },
      {
        "description": "should support several line feeds in fenced code",
        "input": "```x\n\n\ny\n\n\n```\n\n\n",
        "expected": {
          "html": "<pre><code class=\"language-x\">\n\ny\n\n\n</code></pre>"
        }
      },
      {
        "description": "should support several carriage returns in fenced code",
        "comment": "micromark renders: <pre><code class=\"language-x\">\r\ry\r\r\r</code></pre>\r",
        "input": "```x\r\r\ry\r\r\r```\r\r\r",
        "expected": {
          "html": "<pre><code class=\"language-x\">\r\ry\r\r\n</code></pre>"
        }
      },
      {
        "description": "should support several carriage return + line feeds in fenced code",
        "comment": "micromark renders: <pre><code class=\"language-x\">\r\n\r\ny\r\n\r\n\r\n</code></pre>\r\n",
        "input": "```x\r\n\r\n\r\ny\r\n\r\n\r\n```\r\n\r\n\r\n",
        "expected": {
          "html": "<pre><code class=\"language-x\">\r\n\r\ny\r\n\r\n\n</code></pre>"
        }
      },
      {
        "description": "should support a carriage return + line feed in content",
        "input": "A\r\nB\r\n-\r\nC",
        "expected": {
          "html": "<h2>A\r\nB</h2>\n<p>C</p>"
        }
      }
    ]
  },
  {
    "description": "micromark misc/line-ending with dangerous HTML allowed",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/misc/line-ending.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should support a carriage return after html",
        "input": "<div\r",
        "expected": {
          "html": "<div"
        }
      },
      {
        "description": "should support a carriage return + line feed after html",
        "input": "<div\r\n",
        "expected": {
          "html": "<div"
        }
      },
      {
        "description": "should support a blank line w/ line feeds after html",
        "input": "<div>\n\nx",
        "expected": {
          "html": "<div>\n<p>x</p>"
        }
      },
      {
        "description": "should support a blank line w/ carriage returns after html",
        "input": "<div>\r\rx",
        "expected": {
          "html": "<div>\n<p>x</p>"
        }
      },
      {
        "description": "should support a blank line w/ carriage return + line feeds after html",
        "input": "<div>\r\n\r\nx",
        "expected": {
          "html": "<div>\n<p>x</p>"
        }
      },
      {
        "description": "should support a non-blank line w/ line feed in html",
        "input": "<div>\nx",
        "expected": {
          "html": "<div>\nx"
        }
      },
      {
        "description": "should support a non-blank line w/ carriage return in html",
        "input": "<div>\rx",
        "expected": {
          "html": "<div>\rx"
        }
      },
      {
        "description": "should support a non-blank line w/ carriage return + line feed in html",
        "input": "<div>\r\nx",
        "expected": {
          "html": "<div>\r\nx"
        }
      }
    ]
  }
]
