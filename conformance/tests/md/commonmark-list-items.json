[
  {
    "description": "List items",
    "specification": ["https://spec.commonmark.org/0.31.2/#list-items"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 253",
        "input": "A paragraph\nwith two lines.\n\n    indented code\n\n> A block quote.\n",
        "expected": {
          "html": "<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>"
        }
      },
      {
        "description": "example 254",
        "input": "1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 255",
        "input": "- one\n\n two\n",
        "expected": {
          "html": "<ul>\n<li>one</li>\n</ul>\n<p>two</p>"
        }
      },
      {
        "description": "example 256",
        "input": "- one\n\n  two\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 257",
        "input": " -    one\n\n     two\n",
        "expected": {
          "html": "<ul>\n<li>one</li>\n</ul>\n<pre><code> two\n</code></pre>"
        }
      },
      {
        "description": "example 258",
        "input": " -    one\n\n      two\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 259",
        "input": "   > > 1.  one\n>>\n>>     two\n",
        "expected": {
          "html": "<blockquote>\n<blockquote>\n<ol>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ol>\n</blockquote>\n</blockquote>"
        }
      },
      {
        "description": "example 260",
        "input": ">>- one\n>>\n  >  > two\n",
        "expected": {
          "html": "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n</blockquote>\n</blockquote>"
        }
      },
      {
        "description": "example 261",
        "input": "-one\n\n2.two\n",
        "expected": {
          "html": "<p>-one</p>\n<p>2.two</p>"
        }
      },
      {
        "description": "example 262",
        "input": "- foo\n\n\n  bar\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 263",
        "input": "1.  foo\n\n    ```\n    bar\n    ```\n\n    baz\n\n    > bam\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n<blockquote>\n<p>bam</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 264",
        "input": "- Foo\n\n      bar\n\n\n      baz\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>Foo</p>\n<pre><code>bar\n\n\nbaz\n</code></pre>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 265",
        "input": "123456789. ok\n",
        "expected": {
          "html": "<ol start=\"123456789\">\n<li>ok</li>\n</ol>"
        }
      },
      {
        "description": "example 266",
        "input": "1234567890. not ok\n",
        "expected": {
          "html": "<p>1234567890. not ok</p>"
        }
      },
      {
        "description": "example 267",
        "input": "0. ok\n",
        "expected": {
          "html": "<ol start=\"0\">\n<li>ok</li>\n</ol>"
        }
      },
      {
        "description": "example 268",
        "input": "003. ok\n",
        "expected": {
          "html": "<ol start=\"3\">\n<li>ok</li>\n</ol>"
        }
      },
      {
        "description": "example 269",
        "input": "-1. not ok\n",
        "expected": {
          "html": "<p>-1. not ok</p>"
        }
      },
      {
        "description": "example 270",
        "input": "- foo\n\n      bar\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 271",
        "input": "  10.  foo\n\n           bar\n",
        "expected": {
          "html": "<ol start=\"10\">\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 272",
        "input": "    indented code\n\nparagraph\n\n    more code\n",
        "expected": {
          "html": "<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>"
        }
      },
      {
        "description": "example 273",
        "input": "1.     indented code\n\n   paragraph\n\n       more code\n",
        "expected": {
          "html": "<ol>\n<li>\n<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 274",
        "input": "1.      indented code\n\n   paragraph\n\n       more code\n",
        "expected": {
          "html": "<ol>\n<li>\n<pre><code> indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 275",
        "input": "   foo\n\nbar\n",
        "expected": {
          "html": "<p>foo</p>\n<p>bar</p>"
        }
      },
      {
        "description": "example 276",
        "input": "-    foo\n\n  bar\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n</ul>\n<p>bar</p>"
        }
      },
      {
        "description": "example 277",
        "input": "-  foo\n\n   bar\n",
        "expected": {
          "html": "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 278",
        "input": "-\n  foo\n-\n  ```\n  bar\n  ```\n-\n      baz\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n<li>\n<pre><code>bar\n</code></pre>\n</li>\n<li>\n<pre><code>baz\n</code></pre>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 279",
        "input": "-   \n  foo\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n</ul>"
        }
      },
      {
        "description": "example 280",
        "input": "-\n\n  foo\n",
        "expected": {
          "html": "<ul>\n<li></li>\n</ul>\n<p>foo</p>"
        }
      },
      {
        "description": "example 281",
        "input": "- foo\n-\n- bar\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ul>"
        }
      },
      {
        "description": "example 282",
        "input": "- foo\n-   \n- bar\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ul>"
        }
      },
      {
        "description": "example 283",
        "input": "1. foo\n2.\n3. bar\n",
        "expected": {
          "html": "<ol>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ol>"
        }
      },
      {
        "description": "example 284",
        "input": "*\n",
        "expected": {
          "html": "<ul>\n<li></li>\n</ul>"
        }
      },
      {
        "description": "example 285",
        "input": "foo\n*\n\nfoo\n1.\n",
        "expected": {
          "html": "<p>foo\n*</p>\n<p>foo\n1.</p>"
        }
      },
      {
        "description": "example 286",
        "input": " 1.  A paragraph\n     with two lines.\n\n         indented code\n\n     > A block quote.\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 287",
        "input": "  1.  A paragraph\n      with two lines.\n\n          indented code\n\n      > A block quote.\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 288",
        "input": "   1.  A paragraph\n       with two lines.\n\n           indented code\n\n       > A block quote.\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 289",
        "input": "    1.  A paragraph\n        with two lines.\n\n            indented code\n\n        > A block quote.\n",
        "expected": {
          "html": "<pre><code>1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n</code></pre>"
        }
      },
      {
        "description": "example 290",
        "input": "  1.  A paragraph\nwith two lines.\n\n          indented code\n\n      > A block quote.\n",
        "expected": {
          "html": "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 291",
        "input": "  1.  A paragraph\n    with two lines.\n",
        "expected": {
          "html": "<ol>\n<li>A paragraph\nwith two lines.</li>\n</ol>"
        }
      },
      {
        "description": "example 292",
        "input": "> 1. > Blockquote\ncontinued here.\n",
        "expected": {
          "html": "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote\ncontinued here.</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>"
        }
      },
      {
        "description": "example 293",
        "input": "> 1. > Blockquote\n> continued here.\n",
        "expected": {
          "html": "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote\ncontinued here.</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>"
        }
      },
      {
        "description": "example 294",
        "input": "- foo\n  - bar\n    - baz\n      - boo\n",
        "expected": {
          "html": "<ul>\n<li>foo\n<ul>\n<li>bar\n<ul>\n<li>baz\n<ul>\n<li>boo</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 295",
        "input": "- foo\n - bar\n  - baz\n   - boo\n",
        "expected": {
          "html": "<ul>\n<li>foo</li>\n<li>bar</li>\n<li>baz</li>\n<li>boo</li>\n</ul>"
        }
      },
      {
        "description": "example 296",
        "input": "10) foo\n    - bar\n",
        "expected": {
          "html": "<ol start=\"10\">\n<li>foo\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 297",
        "input": "10) foo\n   - bar\n",
        "expected": {
          "html": "<ol start=\"10\">\n<li>foo</li>\n</ol>\n<ul>\n<li>bar</li>\n</ul>"
        }
      },
      {
        "description": "example 298",
        "input": "- - foo\n",
        "expected": {
          "html": "<ul>\n<li>\n<ul>\n<li>foo</li>\n</ul>\n</li>\n</ul>"
        }
      },
      {
        "description": "example 299",
        "input": "1. - 2. foo\n",
        "expected": {
          "html": "<ol>\n<li>\n<ul>\n<li>\n<ol start=\"2\">\n<li>foo</li>\n</ol>\n</li>\n</ul>\n</li>\n</ol>"
        }
      },
      {
        "description": "example 300",
        "input": "- # Foo\n- Bar\n  ---\n  baz\n",
        "expected": {
          "html": "<ul>\n<li>\n<h1>Foo</h1>\n</li>\n<li>\n<h2>Bar</h2>\nbaz</li>\n</ul>"
        }
      }
    ]
  }
]
