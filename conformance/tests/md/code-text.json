[
  {
    "description": "Code spans",
    "specification": ["https://spec.commonmark.org/0.31.2/#code-spans"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 328",
        "input": "`foo`\n",
        "expected": {
          "html": "<p><code>foo</code></p>"
        }
      },
      {
        "description": "example 329",
        "input": "`` foo ` bar ``\n",
        "expected": {
          "html": "<p><code>foo ` bar</code></p>"
        }
      },
      {
        "description": "example 330",
        "input": "` `` `\n",
        "expected": {
          "html": "<p><code>``</code></p>"
        }
      },
      {
        "description": "example 331",
        "input": "`  ``  `\n",
        "expected": {
          "html": "<p><code> `` </code></p>"
        }
      },
      {
        "description": "example 332",
        "input": "` a`\n",
        "expected": {
          "html": "<p><code> a</code></p>"
        }
      },
      {
        "description": "example 333",
        "input": "` b `\n",
        "expected": {
          "html": "<p><code> b </code></p>"
        }
      },
      {
        "description": "example 334",
        "input": "` `\n`  `\n",
        "expected": {
          "html": "<p><code> </code>\n<code>  </code></p>"
        }
      },
      {
        "description": "example 335",
        "input": "``\nfoo\nbar  \nbaz\n``\n",
        "expected": {
          "html": "<p><code>foo bar   baz</code></p>"
        }
      },
      {
        "description": "example 336",
        "input": "``\nfoo \n``\n",
        "expected": {
          "html": "<p><code>foo </code></p>"
        }
      },
      {
        "description": "example 337",
        "input": "`foo   bar \nbaz`\n",
        "expected": {
          "html": "<p><code>foo   bar  baz</code></p>"
        }
      },
      {
        "description": "example 338",
        "input": "`foo\\`bar`\n",
        "expected": {
          "html": "<p><code>foo\\</code>bar`</p>"
        }
      },
      {
        "description": "example 339",
        "input": "``foo`bar``\n",
        "expected": {
          "html": "<p><code>foo`bar</code></p>"
        }
      },
      {
        "description": "example 340",
        "input": "` foo `` bar `\n",
        "expected": {
          "html": "<p><code>foo `` bar</code></p>"
        }
      },
      {
        "description": "example 341",
        "input": "*foo`*`\n",
        "expected": {
          "html": "<p>*foo<code>*</code></p>"
        }
      },
      {
        "description": "example 342",
        "input": "[not a `link](/foo`)\n",
        "expected": {
          "html": "<p>[not a <code>link](/foo</code>)</p>"
        }
      },
      {
        "description": "example 343",
        "input": "`<a href=\"`\">`\n",
        "expected": {
          "html": "<p><code>&#x3C;a href=\"</code>\">`</p>"
        }
      },
      {
        "description": "example 344",
        "input": "<a href=\"`\">`\n",
        "expected": {
          "html": "<p><a href=\"`\">`</p>"
        }
      },
      {
        "description": "example 345",
        "input": "`<https://foo.bar.`baz>`\n",
        "expected": {
          "html": "<p><code>&#x3C;https://foo.bar.</code>baz>`</p>"
        }
      },
      {
        "description": "example 346",
        "input": "<https://foo.bar.`baz>`\n",
        "expected": {
          "html": "<p><a href=\"https://foo.bar.%60baz\">https://foo.bar.`baz</a>`</p>"
        }
      },
      {
        "description": "example 347",
        "input": "```foo``\n",
        "expected": {
          "html": "<p>```foo``</p>"
        }
      },
      {
        "description": "example 348",
        "input": "`foo\n",
        "expected": {
          "html": "<p>`foo</p>"
        }
      },
      {
        "description": "example 349",
        "input": "`foo``bar``\n",
        "expected": {
          "html": "<p>`foo<code>bar</code></p>"
        }
      }
    ]
  },
  {
    "description": "micromark text/code",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/code.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support code",
        "input": "`foo`",
        "expected": {
          "html": "<p><code>foo</code></p>"
        }
      },
      {
        "description": "should support code w/ more accents",
        "input": "`` foo ` bar ``",
        "expected": {
          "html": "<p><code>foo ` bar</code></p>"
        }
      },
      {
        "description": "should support code w/ fences inside, and padding",
        "input": "` `` `",
        "expected": {
          "html": "<p><code>``</code></p>"
        }
      },
      {
        "description": "should support code w/ extra padding",
        "input": "`  ``  `",
        "expected": {
          "html": "<p><code> `` </code></p>"
        }
      },
      {
        "description": "should support code w/ padding and one character",
        "input": "`` ` ``",
        "expected": {
          "html": "<p><code>`</code></p>"
        }
      },
      {
        "description": "should support code w/ unbalanced padding",
        "input": "` a`",
        "expected": {
          "html": "<p><code> a</code></p>"
        }
      },
      {
        "description": "should support code w/ non-padding whitespace",
        "input": "` b `",
        "expected": {
          "html": "<p><code> b </code></p>"
        }
      },
      {
        "description": "should support code w/o data",
        "input": "` `\n`  `",
        "expected": {
          "html": "<p><code> </code>\n<code>  </code></p>"
        }
      },
      {
        "description": "should support code w/o line endings (1)",
        "input": "``\nfoo\nbar  \nbaz\n``",
        "expected": {
          "html": "<p><code>foo bar   baz</code></p>"
        }
      },
      {
        "description": "should support code w/o line endings (2)",
        "input": "``\nfoo \n``",
        "expected": {
          "html": "<p><code>foo </code></p>"
        }
      },
      {
        "description": "should not support whitespace collapsing",
        "input": "`foo   bar \nbaz`",
        "expected": {
          "html": "<p><code>foo   bar  baz</code></p>"
        }
      },
      {
        "description": "should not support character escapes",
        "input": "`foo\\`bar`",
        "expected": {
          "html": "<p><code>foo\\</code>bar`</p>"
        }
      },
      {
        "description": "should support more accents",
        "input": "``foo`bar``",
        "expected": {
          "html": "<p><code>foo`bar</code></p>"
        }
      },
      {
        "description": "should support less accents",
        "input": "` foo `` bar `",
        "expected": {
          "html": "<p><code>foo `` bar</code></p>"
        }
      },
      {
        "description": "should precede over emphasis",
        "input": "*foo`*`",
        "expected": {
          "html": "<p>*foo<code>*</code></p>"
        }
      },
      {
        "description": "should precede over links",
        "input": "[not a `link](/foo`)",
        "expected": {
          "html": "<p>[not a <code>link](/foo</code>)</p>"
        }
      },
      {
        "description": "should have same precedence as HTML (1)",
        "input": "`<a href=\"`\">`",
        "expected": {
          "html": "<p><code>&#x3C;a href=\"</code>\">`</p>"
        }
      },
      {
        "description": "should have same precedence as autolinks (1)",
        "input": "`<http://foo.bar.`baz>`",
        "expected": {
          "html": "<p><code>&#x3C;http://foo.bar.</code>baz>`</p>"
        }
      },
      {
        "description": "should have same precedence as autolinks (2)",
        "input": "<http://foo.bar.`baz>`",
        "expected": {
          "html": "<p><a href=\"http://foo.bar.%60baz\">http://foo.bar.`baz</a>`</p>"
        }
      },
      {
        "description": "should not support more accents before a fence",
        "input": "```foo``",
        "expected": {
          "html": "<p>```foo``</p>"
        }
      },
      {
        "description": "should not support no closing fence (1)",
        "input": "`foo",
        "expected": {
          "html": "<p>`foo</p>"
        }
      },
      {
        "description": "should not support no closing fence (2)",
        "input": "`foo``bar``",
        "expected": {
          "html": "<p>`foo<code>bar</code></p>"
        }
      },
      {
        "description": "should support tabs in code",
        "input": "`foo\t\tbar`",
        "expected": {
          "html": "<p><code>foo\t\tbar</code></p>"
        }
      },
      {
        "description": "should support an escaped initial grave accent",
        "input": "\\``x`",
        "expected": {
          "html": "<p>`<code>x</code></p>"
        }
      }
    ]
  },
  {
    "description": "micromark text/code with dangerous HTML allowed",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/code.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should have same precedence as HTML (2)",
        "input": "<a href=\"`\">`",
        "expected": {
          "html": "<p><a href=\"`\">`</p>"
        }
      }
    ]
  }
]
