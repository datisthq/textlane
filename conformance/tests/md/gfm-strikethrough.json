  {
    "description": "remark-gfm fixtures (tree)",
    "source": {
      "repository": "https://github.com/remarkjs/remark-gfm",
      "commit": "109972e8a773bf5dac1d6d2da0776557f36971aa",
      "path": "test/fixtures",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.gfm"]],
    "tests": [
      {
        "description": "fixture strikethrough-default",
        "input": "~one~, ~~two~~, ~~~three~~~.\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "delete",
                    "children": [
                      {
                        "type": "text",
                        "value": "one",
