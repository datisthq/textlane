[
  {
    "description": "GFM spec: Strikethrough",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm",
      "commit": "cd4e38f455e5872eefc83c9036ca621ba954cad8",
      "path": "test/spec.js",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      ["md.gfm"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 11",
        "input": "~~Hi~~ Hello, ~there~ world!\n",
        "expected": {
          "html": "<p><del>Hi</del> Hello, <del>there</del> world!</p>"
        }
      },
      {
        "description": "example 12",
        "input": "This ~~has a\n\nnew paragraph~~.\n",
        "expected": {
          "html": "<p>This ~~has a</p>\n<p>new paragraph~~.</p>"
        }
      },
      {
        "description": "example 13",
        "input": "This will ~~~not~~~ strike.\n",
        "expected": {
          "html": "<p>This will ~~~not~~~ strike.</p>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-strikethrough",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-strikethrough",
      "commit": "895451f924c543c6a528e80b7340236e164eb384",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.gfm"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support strikethrough w/ one tilde",
        "input": "a ~b~",
        "expected": {
          "html": "<p>a <del>b</del></p>"
        }
      },
      {
        "description": "should support strikethrough w/ two tildes",
        "input": "a ~~b~~",
        "expected": {
          "html": "<p>a <del>b</del></p>"
        }
      },
      {
        "description": "should not support strikethrough w/ three tildes",
        "input": "a ~~~b~~~",
        "expected": {
          "html": "<p>a ~~~b~~~</p>"
        }
      },
      {
        "description": "should support strikethrough w/ after an escaped tilde",
        "input": "a \\~~~b~~ c",
        "expected": {
          "html": "<p>a ~<del>b</del> c</p>"
        }
      },
      {
        "description": "should support nested strikethrough",
        "input": "a ~~b ~~c~~ d~~ e",
        "expected": {
          "html": "<p>a <del>b <del>c</del> d</del> e</p>"
        }
      },
      {
        "description": "should open if preceded by whitespace and followed by punctuation",
        "input": "a ~-1~ b",
        "expected": {
          "html": "<p>a <del>-1</del> b</p>"
        }
      },
      {
        "description": "should close if preceded by punctuation and followed by whitespace",
        "input": "a ~b.~ c",
        "expected": {
          "html": "<p>a <del>b.</del> c</p>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-strikethrough (singleTilde true)",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-strikethrough",
      "commit": "895451f924c543c6a528e80b7340236e164eb384",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.gfm",
        {
          "singleTilde": true
        }
      ],
      ["md.toHtml"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "should close if preceded and followed by punctuation (del)",
        "input": "~b.~.",
        "expected": {
          "html": "<p><del>b.</del>.</p>"
        }
      },
      {
        "description": "should support strikethrough w/ one tilde if `singleTilde: true`",
        "input": "a ~b~ ~~c~~ d",
        "expected": {
          "html": "<p>a <del>b</del> <del>c</del> d</p>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-strikethrough (singleTilde false)",
    "source": {
      "repository": "https://github.com/micromark/micromark-extension-gfm-strikethrough",
      "commit": "895451f924c543c6a528e80b7340236e164eb384",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.gfm",
        {
          "singleTilde": false
        }
      ],
      ["md.toHtml"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "should not support strikethrough w/ one tilde if `singleTilde: false`",
        "input": "a ~b~ ~~c~~ d",
        "expected": {
          "html": "<p>a ~b~ <del>c</del> d</p>"
        }
      }
    ]
  },
  {
    "description": "micromark-extension-gfm-strikethrough fixtures",
    "source": {
