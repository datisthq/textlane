[
  {
    "description": "Textual content",
    "specification": ["https://spec.commonmark.org/0.31.2/#textual-content"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 650",
        "input": "hello $.;'there\n",
        "expected": {
          "html": "<p>hello $.;'there</p>"
        }
      },
      {
        "description": "example 651",
        "input": "Foo χρῆν\n",
        "expected": {
          "html": "<p>Foo χρῆν</p>"
        }
      },
      {
        "description": "example 652",
        "input": "Multiple     spaces\n",
        "expected": {
          "html": "<p>Multiple     spaces</p>"
        }
      }
    ]
  },
  {
    "description": "Textual content (tree)",
    "specification": ["https://spec.commonmark.org/0.31.2/#textual-content"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"]],
    "tests": [
      {
        "description": "example 650",
        "input": "hello $.;'there\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "hello $.;'there",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 16,
                        "offset": 15
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 16,
                    "offset": 15
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 16
              }
            }
          }
        }
      },
      {
        "description": "example 651",
        "input": "Foo χρῆν\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Foo χρῆν",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 9,
                        "offset": 8
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 9,
                    "offset": 8
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 9
              }
            }
          }
        }
      },
      {
        "description": "example 652",
        "input": "Multiple     spaces\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Multiple     spaces",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 20,
                        "offset": 19
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 20,
                    "offset": 19
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 20
              }
            }
          }
        }
      }
    ]
  },
  {
    "description": "micromark text/text",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/text.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support ascii text",
        "input": "hello $.;'there",
        "expected": {
          "html": "<p>hello $.;'there</p>"
        }
      },
      {
        "description": "should support unicode text",
        "input": "Foo χρῆν",
        "expected": {
          "html": "<p>Foo χρῆν</p>"
        }
      },
      {
        "description": "should preserve internal spaces verbatim",
        "input": "Multiple     spaces",
        "expected": {
          "html": "<p>Multiple     spaces</p>"
        }
      }
    ]
  }
]
