[
  {
    "description": "Textual content",
    "specification": ["https://spec.commonmark.org/0.31.2/#textual-content"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [
      ["md.parse"],
      [
        "md.toHtml",
        {
          "allowDangerousHtml": true
        }
      ],
      [
        "html.stringify",
        {
          "allowDangerousHtml": true
        }
      ]
    ],
    "tests": [
      {
        "description": "example 650",
        "input": "hello $.;'there\n",
        "expected": {
          "html": "<p>hello $.;'there</p>"
        }
      },
      {
        "description": "example 651",
        "input": "Foo χρῆν\n",
        "expected": {
          "html": "<p>Foo χρῆν</p>"
        }
      },
      {
        "description": "example 652",
        "input": "Multiple     spaces\n",
        "expected": {
          "html": "<p>Multiple     spaces</p>"
        }
      }
    ]
  },
  {
    "description": "Textual content (tree)",
    "specification": ["https://spec.commonmark.org/0.31.2/#textual-content"],
    "source": {
      "repository": "https://github.com/commonmark/commonmark-spec",
      "version": "0.31.2",
      "path": "spec.txt",
      "license": "CC-BY-SA-4.0"
    },
    "pipeline": [["md.parse"]],
    "tests": [
      {
        "description": "example 650",
        "input": "hello $.;'there\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "hello $.;'there",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 16,
                        "offset": 15
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 16,
                    "offset": 15
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 16
              }
            }
          }
        }
      },
      {
        "description": "example 651",
        "input": "Foo χρῆν\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Foo χρῆν",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 9,
                        "offset": 8
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 9,
                    "offset": 8
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 9
              }
            }
          }
        }
      },
      {
        "description": "example 652",
        "input": "Multiple     spaces\n",
        "expected": {
          "tree": {
            "type": "root",
            "children": [
              {
                "type": "paragraph",
                "children": [
                  {
                    "type": "text",
                    "value": "Multiple     spaces",
                    "position": {
                      "start": {
                        "line": 1,
                        "column": 1,
                        "offset": 0
                      },
                      "end": {
                        "line": 1,
                        "column": 20,
                        "offset": 19
                      }
                    }
                  }
                ],
                "position": {
                  "start": {
                    "line": 1,
                    "column": 1,
                    "offset": 0
                  },
                  "end": {
                    "line": 1,
                    "column": 20,
                    "offset": 19
                  }
                }
              }
            ],
            "position": {
              "start": {
                "line": 1,
                "column": 1,
                "offset": 0
              },
              "end": {
                "line": 2,
                "column": 1,
                "offset": 20
              }
            }
          }
        }
      }
    ]
  },
  {
    "description": "micromark text/text",
    "source": {
      "repository": "https://github.com/micromark/micromark",
      "commit": "6577c200155e9c6b85a42b26d298f8affc348f2f",
      "path": "test/io/text/text.js",
      "license": "MIT"
    },
    "pipeline": [["md.parse"], ["md.toHtml"], ["html.stringify"]],
    "tests": [
      {
        "description": "should support ascii text",
        "input": "hello $.;'there",
        "expected": {
          "html": "<p>hello $.;'there</p>"
        }
      },
      {
        "description": "should support unicode text",
        "input": "Foo χρῆν",
        "expected": {
          "html": "<p>Foo χρῆν</p>"
        }
      },
      {
        "description": "should preserve internal spaces verbatim",
        "input": "Multiple     spaces",
        "expected": {
          "html": "<p>Multiple     spaces</p>"
        }
      }
    ]
  },
  {
    "description": "to-markdown text",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-markdown",
      "commit": "a31fe0608ff3c68f92f79bc5acc35235d8b69cee",
      "path": "test/index.js",
      "license": "MIT"
    },
    "pipeline": [["md.stringify"]],
    "tests": [
      {
        "description": "should support a void text",
        "tree": {
          "type": "text"
        },
        "expected": {
          "md": ""
        }
      },
      {
        "description": "should support an empty text",
        "tree": {
          "type": "text",
          "value": ""
        },
        "expected": {
          "md": ""
        }
      },
      {
        "description": "should support text",
        "tree": {
          "type": "text",
          "value": "a\nb"
        },
        "expected": {
          "md": "a\nb\n"
        }
      },
      {
        "description": "should escape text given directly",
        "tree": {
          "type": "text",
          "value": "*a*"
        },
        "expected": {
          "md": "\\*a\\*\n"
        }
      }
    ]
  },
  {
    "description": "mdast-util-to-hast text",
    "source": {
      "repository": "https://github.com/syntax-tree/mdast-util-to-hast",
      "commit": "174795b21f7757fffb54dd8d5fb4012f4751f791",
      "path": "test/text.js",
      "license": "MIT"
    },
    "pipeline": [["md.toHtml"]],
    "tests": [
      {
        "description": "should map `text`s",
        "tree": {
          "type": "text",
          "value": "alpha"
        },
        "expected": {
          "tree": {
            "type": "text",
            "value": "alpha"
          }
        }
      },
      {
        "description": "should trim spaces and tabs around eols",
        "tree": {
          "type": "text",
          "value": "bravo \n \n charlie"
        },
        "expected": {
          "tree": {
            "type": "text",
            "value": "bravo\n\ncharlie"
          }
        }
      },
      {
        "description": "should transform text nodes w/ `hName` to an `element`",
        "tree": {
          "type": "text",
          "value": "delta",
          "data": {
            "hName": "span"
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "span",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "delta"
              }
            ]
          }
        }
      },
      {
        "description": "should ignore `hProperties` on text nodes w/o `hName`",
        "tree": {
          "type": "text",
          "value": "echo",
          "data": {
            "hProperties": {
              "className": ["foxtrot"]
            }
          }
        },
        "expected": {
          "tree": {
            "type": "text",
            "value": "echo"
          }
        }
      },
      {
        "description": "should transform text nodes w/ `hProperties` and `hName` to an `element`",
        "tree": {
          "type": "text",
          "value": "golf",
          "data": {
            "hName": "span",
            "hProperties": {
              "className": ["hotel"]
            }
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "span",
            "properties": {
              "className": ["hotel"]
            },
            "children": [
              {
                "type": "text",
                "value": "golf"
              }
            ]
          }
        }
      },
      {
        "description": "should not transform text nodes w/ `hChildren` w/o `hName` to an `element`",
        "tree": {
          "type": "text",
          "value": "india",
          "data": {
            "hChildren": [
              {
                "type": "text",
                "value": "juliett"
              }
            ]
          }
        },
        "expected": {
          "tree": {
            "type": "text",
            "value": "india"
          }
        }
      },
      {
        "description": "should transform text nodes w/ `hChildren` and `hName` to an `element`",
        "tree": {
          "type": "text",
          "value": "kilo",
          "data": {
            "hName": "span",
            "hChildren": [
              {
                "type": "text",
                "value": "lima"
              }
            ]
          }
        },
        "expected": {
          "tree": {
            "type": "element",
            "tagName": "span",
            "properties": {},
            "children": [
              {
                "type": "text",
                "value": "lima"
              }
            ]
          }
        }
      }
    ]
  }
]
