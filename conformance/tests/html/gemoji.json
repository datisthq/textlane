[
  {
    "description": "shortcodes in text",
    "pipeline": [
      [
        "html.parse",
        {
          "fragment": true
        }
      ],
      ["html.gemoji"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "known names only, never in code",
        "input": "<p>:rocket: 10:30:00</p><code>:rocket:</code>",
        "expected": {
          "html": "<p>🚀 10:30:00</p><code>:rocket:</code>"
        }
      }
    ]
  }
]
