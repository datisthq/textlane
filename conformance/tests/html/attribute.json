    "pipeline": [["html.stringify"]],
    "tests": [
      {
        "description": "should ignore unknowns set to `false`",
        "tree": {
          "type": "element",
          "tagName": "i",
          "properties": {
            "unknown": false
          },
          "children": []
        },
        "expected": {
          "html": "<i></i>"
        }
      },
      {
        "description": "should ignore unknowns set to `null`",
        "tree": {
          "type": "element",
          "tagName": "i",
          "properties": {
            "unknown": null
          },
          "children": []
        },
        "expected": {
          "html": "<i></i>"
        }
      },
      {
        "description": "should ignore unknowns set to `undefined`",
        "tree": {
          "type": "element",
          "tagName": "i",
