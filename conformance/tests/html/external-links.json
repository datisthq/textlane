        "expected": {
          "html": "<a href=\"https://example.com\" rel=\"nofollow\">a</a> <a href=\"http://example.com\" rel=\"nofollow\">b</a> <a href=\"//cdn.example.com/x\" rel=\"nofollow\">c</a> <a href=\"mailto:a@example.com\">d</a> <a href=\"/docs\">e</a> <a href=\"#top\">f</a> <a href=\"ftp://example.com\">g</a> <a href=\"HTTP://example.com\">h</a> <a href=\"C:\\path\">i</a> <a>j</a>"
