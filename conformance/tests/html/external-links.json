          "html": "<a href=\"https://example.com\" rel=\"noopener noreferrer\" target=\"_blank\">a</a> <a href=\"http://example.com\" rel=\"noopener noreferrer\" target=\"_blank\">b</a> <a href=\"//cdn.example.com/x\" rel=\"noopener noreferrer\" target=\"_blank\">c</a> <a href=\"mailto:a@example.com\">d</a> <a href=\"/docs\">e</a> <a href=\"#top\">f</a> <a href=\"ftp://example.com\">g</a> <a href=\"HTTP://example.com\">h</a> <a href=\"C:\\path\">i</a> <a>j</a>"
        }
      }
    ]
