[
  {
    "description": "headings as a table of contents in the file's data",
    "source": {
      "repository": "https://github.com/stefanprobst/rehype-extract-toc",
      "version": "3.0.0",
      "path": "src/index.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "html.parse",
        {
          "fragment": true
        }
      ],
      ["html.slug"],
      ["html.extractToc"],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "nested headings",
        "input": "<h1>A</h1><h2>B</h2><h3>C</h3><h2>D</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 1,
                "value": "A",
                "id": "a",
                "children": [
                  {
                    "depth": 2,
                    "value": "B",
                    "id": "b",
                    "children": [
                      {
                        "depth": 3,
                        "value": "C",
                        "id": "c"
                      }
                    ]
                  },
                  {
                    "depth": 2,
                    "value": "D",
                    "id": "d"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "a level skipped",
        "input": "<h1>A</h1><h3>B</h3><h2>C</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 1,
                "value": "A",
                "id": "a",
                "children": [
                  {
                    "depth": 3,
                    "value": "B",
                    "id": "b"
                  },
                  {
                    "depth": 2,
                    "value": "C",
                    "id": "c"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "shallower after deeper",
        "input": "<h3>A</h3><h1>B</h1><h2>C</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 3,
                "value": "A",
                "id": "a"
              },
              {
                "depth": 1,
                "value": "B",
                "id": "b",
                "children": [
                  {
                    "depth": 2,
                    "value": "C",
                    "id": "c"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "siblings at one level",
        "input": "<h2>A</h2><h2>B</h2><h2>C</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a"
              },
              {
                "depth": 2,
                "value": "B",
                "id": "b"
              },
              {
                "depth": 2,
                "value": "C",
                "id": "c"
              }
            ]
          }
        }
      },
      {
        "description": "text inside elements",
        "input": "<h2>An <em>emphasized</em> <code>code</code></h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "An emphasized code",
                "id": "an-emphasized-code"
              }
            ]
          }
        }
      },
      {
        "description": "headings inside sections",
        "input": "<section><h2>A</h2><div><h3>B</h3></div></section>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a",
                "children": [
                  {
                    "depth": 3,
                    "value": "B",
                    "id": "b"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "no headings",
        "input": "<p>Text</p>",
        "expected": {
          "fileData": {
            "toc": []
          }
        }
      },
      {
        "description": "duplicate titles",
        "input": "<h2>Same</h2><h2>Same</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "Same",
                "id": "same"
              },
              {
                "depth": 2,
                "value": "Same",
                "id": "same-1"
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "skip leaves headings with an attribute out",
    "comment": "textlane's own option; rehype-extract-toc has none",
    "pipeline": [
      [
        "html.parse",
        {
          "fragment": true
        }
      ],
      ["html.slug"],
      [
        "html.extractToc",
        {
          "skip": ["data-step", "data-toc-hidden"]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "skipped headings stay out",
        "input": "<h2>A</h2><h2 data-step>Step</h2><h2 data-toc-hidden>Hidden</h2><h2>B</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a"
              },
              {
                "depth": 2,
                "value": "B",
                "id": "b"
              }
            ]
          }
        }
      },
      {
        "description": "what nests under a skipped heading nests under the one before",
        "input": "<h2>A</h2><h2 data-toc-hidden>Hidden</h2><h3>C</h3>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a",
                "children": [
                  {
                    "depth": 3,
                    "value": "C",
                    "id": "c"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "a hidden heading is still listed",
        "input": "<h2>A</h2><h2 hidden>Only in the TOC</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a"
              },
              {
                "depth": 2,
                "value": "Only in the TOC",
                "id": "only-in-the-toc"
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "skip reads attributes a marker set",
    "pipeline": [
      ["md.parse"],
      [
        "md.headingId",
        {
          "markers": {
            "[!toc]": {
              "data-toc-hidden": true
            }
          }
        }
      ],
      ["md.toHtml"],
      ["html.slug"],
      [
        "html.extractToc",
        {
          "skip": ["data-toc-hidden"]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "a hidden heading from Markdown",
        "input": "## A\n\n## Hidden [!toc]\n\n## B",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "id": "a"
              },
              {
                "depth": 2,
                "value": "B",
                "id": "b"
              }
            ]
          }
        }
      }
    ]
  },
  {
    "description": "depth range, skip by value and skipInside",
    "pipeline": [
      [
        "html.parse",
        {
          "fragment": true
        }
      ],
      [
        "html.extractToc",
        {
          "minDepth": 2,
          "maxDepth": 3,
          "skip": ["data-toc=false"],
          "skipInside": ["aside"]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "only h2 and h3 are listed",
        "input": "<h1>T</h1><h2>A</h2><h3>B</h3><h4>C</h4>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "children": [
                  {
                    "depth": 3,
                    "value": "B"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "description": "a heading with the skipped value stays out, another value stays in",
        "input": "<h2 data-toc=\"false\">A</h2><h2 data-toc=\"only\">B</h2>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "B"
              }
            ]
          }
        }
      },
      {
        "description": "headings inside a skipped element stay out",
        "input": "<h2>A</h2><aside><div><h3>B</h3></div></aside><h3>C</h3>",
        "expected": {
          "fileData": {
            "toc": [
              {
                "depth": 2,
                "value": "A",
                "children": [
                  {
                    "depth": 3,
                    "value": "C"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  }
]
