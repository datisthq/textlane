        }
      ]
    ],
    "tests": [
      {
        "description": "should serialize voids with `/` in `closeSelfClosing` and `tightSelfClosing` mode, w/ space after an unquoted attribute (1)",
        "tree": {
          "type": "element",
          "tagName": "input",
          "properties": {
            "type": "checkbox"
          },
          "children": []
        },
        "expected": {
          "html": "<input type=checkbox />"
        }
      }
    ]
  },
  {
    "description": "hast-util-to-html element {\"preferUnquoted\":true,\"closeSelfClosing\":true,\"tightSelfClosing\":true}",
    "source": {
      "repository": "https://github.com/syntax-tree/hast-util-to-html",
      "commit": "d115f5beab200c819699e1db9d7eb7b5b1009a21",
      "path": "test/element.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "html.stringify",
        {
          "preferUnquoted": true,
          "closeSelfClosing": true,
          "tightSelfClosing": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should serialize voids with `/` in `closeSelfClosing` and `tightSelfClosing` mode, w/ space after an unquoted attribute (2)",
