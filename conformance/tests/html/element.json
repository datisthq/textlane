          "type": "element",
          "tagName": "img",
          "properties": {
            "src": "index.jpg"
          },
          "children": []
        },
        "expected": {
          "html": "<img src=index.jpg />"
        }
      },
      {
        "description": "should serialize voids with a ` /` in if an unquoted attribute ends with `/`",
        "tree": {
          "type": "element",
          "tagName": "img",
          "properties": {
            "title": "/"
          },
          "children": []
        },
        "expected": {
