  {
    "description": "inline code naming its language",
    "source": {
      "repository": "https://github.com/shikijs/shiki",
      "version": "4.5.0",
      "path": "packages/transformers",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.toHtml"],
      [
        "html.highlight",
        {
          "themes": {
            "light": "catppuccin-latte",
            "dark": "catppuccin-mocha"
          },
          "inline": "tailing-curly-colon"
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "a language",
        "input": "Call `a(1){:js}` now",
        "expected": {
          "html": "<p>Call <span class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#1E66F5;--shiki-light-font-style:italic;--shiki-dark:#89B4FA;--shiki-dark-font-style:italic\">a</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\">(</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\">1</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\">)</span></span></code></span> now</p>"
        }
      },
      {
        "description": "no language",
        "input": "Call `a(1)` now",
        "expected": {
          "html": "<p>Call <code>a(1)</code> now</p>"
        }
      },
      {
        "description": "an unknown language",
        "input": "Call `a(1){:nope}` now",
        "expected": {
          "html": "<p>Call <code>a(1){:nope}</code> now</p>"
        }
      }
    ]
  },
