[
  {
    "description": "colorReplacements for every theme",
    "source": {
      "repository": "https://github.com/shikijs/shiki",
      "version": "4.5.0",
      "path": "packages/transformers",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.toHtml"],
      [
        "html.highlight",
        {
          "themes": {
            "light": "catppuccin-latte",
            "dark": "catppuccin-mocha"
          },
          "colorReplacements": {
            "#40a02b": "#2a7e16",
            "#eff1f5": "#ffffff"
          }
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "a string and the background",
        "input": "```js\nlet a = \"b\"\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha\" style=\"background-color:#ffffff;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#2a7e16;--shiki-dark:#A6E3A1\"> \"b\"</span></span></code></pre>"
        }
      }
    ]
  },
