    "source": {
      "repository": "https://github.com/shikijs/shiki",
      "version": "4.5.0",
      "path": "packages/transformers",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.toHtml"],
      [
        "html.highlight",
        {
          "themes": {
            "light": "catppuccin-latte",
            "dark": "catppuccin-mocha"
          },
          "transformers": ["notationHighlight"]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "highlight",
        "input": "```ts\nlet a = 1 // [!code highlight]\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-highlighted\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line highlighted\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span></span></code></pre>"
