  {
    "description": "transformerNotationDiff",
    "source": {
      "repository": "https://github.com/shikijs/shiki",
      "version": "4.5.0",
      "path": "packages/transformers",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.toHtml"],
      [
        "html.highlight",
        {
          "themes": {
            "light": "catppuccin-latte",
            "dark": "catppuccin-mocha"
          },
          "transformers": ["notationDiff"]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "added and removed lines",
        "input": "```ts\nlet a = 1 // [!code ++]\nlet b = 2 // [!code --]\nlet c = 3\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff add\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span></span>\n<span class=\"line diff remove\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> b </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 2</span></span>\n<span class=\"line\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> c </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 3</span></span></code></pre>"
        }
      },
      {
        "description": "a notation on its own line marks the lines after it",
        "input": "```ts\n// [!code ++:2]\nlet a = 1\nlet b = 2\nlet c = 3\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff add\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span></span>\n<span class=\"line diff add\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> b </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 2</span></span>\n<span class=\"line\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> c </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 3</span></span></code></pre>"
        }
      },
      {
        "description": "a Python comment",
        "input": "```py\na = 1 # [!code ++]\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff add\"><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\">a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span></span></code></pre>"
        }
      },
      {
        "description": "an HTML comment",
        "input": "```html\n<a></a> <!-- [!code --] -->\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff remove\"><span style=\"color:#179299;--shiki-dark:#94E2D5\">&#x3C;</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">a</span><span style=\"color:#179299;--shiki-dark:#94E2D5\">>&#x3C;/</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">a</span><span style=\"color:#179299;--shiki-dark:#94E2D5\">></span></span></code></pre>"
        }
      },
      {
        "description": "a block comment",
        "input": "```css\na { color: red } /* [!code ++] */\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff add\"><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">a</span><span style=\"color:#7C7F93;--shiki-dark:#9399B2\"> {</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\"> color</span><span style=\"color:#179299;--shiki-dark:#94E2D5\">:</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> red </span><span style=\"color:#7C7F93;--shiki-dark:#9399B2\">}</span></span></code></pre>"
        }
      },
      {
        "description": "a JSX comment",
        "input": "```tsx\nconst a = (\n  <div>\n    {/* [!code ++] */}\n    <b />\n  </div>\n)\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">const</span><span style=\"color:#1E66F5;--shiki-light-font-style:italic;--shiki-dark:#89B4FA;--shiki-dark-font-style:italic\"> a</span><span style=\"color:#179299;--shiki-dark:#94E2D5\"> =</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> (</span></span>\n<span class=\"line\"><span style=\"color:#179299;--shiki-dark:#94E2D5\">  &#x3C;</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">div</span><span style=\"color:#179299;--shiki-dark:#94E2D5\">></span></span>\n<span class=\"line diff add\"><span style=\"color:#179299;--shiki-dark:#94E2D5\">    &#x3C;</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">b</span><span style=\"color:#179299;--shiki-dark:#94E2D5\"> /></span></span>\n<span class=\"line\"><span style=\"color:#179299;--shiki-dark:#94E2D5\">  &#x3C;/</span><span style=\"color:#1E66F5;--shiki-dark:#89B4FA\">div</span><span style=\"color:#179299;--shiki-dark:#94E2D5\">></span></span>\n<span class=\"line\"><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\">)</span></span></code></pre>"
        }
      },
      {
        "description": "a comment that keeps more text",
        "input": "```ts\nlet a = 1 // keep [!code ++]\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code><span class=\"line diff add\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span><span style=\"color:#7C7F93;--shiki-light-font-style:italic;--shiki-dark:#9399B2;--shiki-dark-font-style:italic\"> // keep</span></span></code></pre>"
        }
      }
    ]
  },
  {
    "description": "transformerNotationDiff with its classes",
    "source": {
      "repository": "https://github.com/shikijs/shiki",
      "version": "4.5.0",
      "path": "packages/transformers",
      "license": "MIT"
    },
    "pipeline": [
      ["md.parse"],
      ["md.toHtml"],
      [
        "html.highlight",
        {
          "themes": {
            "light": "catppuccin-latte",
            "dark": "catppuccin-mocha"
          },
          "transformers": [
            {
              "name": "notationDiff",
              "classLineAdd": "plus",
              "classLineRemove": ["minus"],
              "classActiveCode": "x"
            }
          ]
        }
      ],
      ["html.stringify"]
    ],
    "tests": [
      {
        "description": "both",
        "input": "```ts\nlet a = 1 // [!code ++]\nlet b = 2 // [!code --]\n```",
        "expected": {
          "html": "<pre class=\"shiki shiki-themes catppuccin-latte catppuccin-mocha has-diff\" style=\"background-color:#eff1f5;--shiki-dark-bg:#1e1e2e;color:#4c4f69;--shiki-dark:#cdd6f4\" tabindex=\"0\"><code class=\"x\"><span class=\"line plus\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> a </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 1</span></span>\n<span class=\"line minus\"><span style=\"color:#8839EF;--shiki-dark:#CBA6F7\">let</span><span style=\"color:#4C4F69;--shiki-dark:#CDD6F4\"> b </span><span style=\"color:#179299;--shiki-dark:#94E2D5\">=</span><span style=\"color:#FE640B;--shiki-dark:#FAB387\"> 2</span></span></code></pre>"
        }
      }
    ]
  },
