[
  {
    "description": "hast-util-to-html svg {\"space\":\"svg\"}",
    "source": {
      "repository": "https://github.com/syntax-tree/hast-util-to-html",
      "commit": "d115f5beab200c819699e1db9d7eb7b5b1009a21",
      "path": "test/svg.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "html.stringify",
        {
          "space": "svg"
        }
      ]
    ],
    "tests": [
      {
        "description": "should serialize `element`s",
        "tree": {
          "type": "element",
          "tagName": "path",
          "properties": {},
          "children": []
        },
        "expected": {
          "html": "<path></path>"
        }
      },
      {
        "description": "should serialize unknown `element`s",
        "tree": {
          "type": "element",
          "tagName": "foo",
          "properties": {},
          "children": []
        },
        "expected": {
          "html": "<foo></foo>"
        }
      },
      {
        "description": "should serialize `element`s with content",
        "tree": {
          "type": "element",
          "tagName": "g",
          "properties": {},
          "children": [
            {
              "type": "element",
              "tagName": "circle",
              "properties": {},
              "children": []
            }
          ]
        },
        "expected": {
          "html": "<g><circle></circle></g>"
        }
      },
      {
        "description": "should serialize special properties",
        "tree": {
          "type": "element",
          "tagName": "text",
          "properties": {
            "className": ["alpha"]
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<text class=\"alpha\">bravo</text>"
        }
      },
      {
        "description": "should serialize multiple properties",
        "tree": {
          "type": "element",
          "tagName": "text",
          "properties": {
            "className": ["a", "b"],
            "title": "c d"
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<text class=\"a b\" title=\"c d\">bravo</text>"
        }
      },
      {
        "description": "should serialize space-separated attributes",
        "tree": {
          "type": "element",
          "tagName": "text",
          "properties": {
            "className": ["alpha", "charlie"]
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<text class=\"alpha charlie\">bravo</text>"
        }
      },
      {
        "description": "should serialize comma-separated attributes",
        "tree": {
          "type": "element",
          "tagName": "glyph",
          "properties": {
            "glyphName": ["foo", "bar"]
          },
          "children": []
        },
        "expected": {
          "html": "<glyph glyph-name=\"foo, bar\"></glyph>"
        }
      },
      {
        "description": "should serialize unknown lists as space-separated",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "unknown": ["alpha", "bravo"]
          },
          "children": []
        },
        "expected": {
          "html": "<circle unknown=\"alpha bravo\"></circle>"
        }
      },
      {
        "description": "should serialize known boolean attributes set to `true`",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "download": true
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a download>bravo</a>"
        }
      },
      {
        "description": "should ignore known boolean attributes set to `false`",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "download": false
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a>bravo</a>"
        }
      },
      {
        "description": "should serialize truthy known boolean attributes",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "download": 1
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a download>bravo</a>"
        }
      },
      {
        "description": "should ignore falsey known boolean attributes",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "download": 0
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a>bravo</a>"
        }
      },
      {
        "description": "should ignore unknown attributes set to `false`",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "unknown": false
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a>bravo</a>"
        }
      },
      {
        "description": "should serialize unknown attributes set to `true`",
        "tree": {
          "type": "element",
          "tagName": "a",
          "properties": {
            "unknown": true
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<a unknown>bravo</a>"
        }
      },
      {
        "description": "should serialize positive known numeric attributes",
        "tree": {
          "type": "element",
          "tagName": "path",
          "properties": {
            "strokeOpacity": 0.7
          },
          "children": []
        },
        "expected": {
          "html": "<path stroke-opacity=\"0.7\"></path>"
        }
      },
      {
        "description": "should serialize negative known numeric attributes",
        "tree": {
          "type": "element",
          "tagName": "path",
          "properties": {
            "strokeMiterLimit": -1
          },
          "children": []
        },
        "expected": {
          "html": "<path stroke-miterlimit=\"-1\"></path>"
        }
      },
      {
        "description": "should serialize known numeric attributes set to `0`",
        "tree": {
          "type": "element",
          "tagName": "path",
          "properties": {
            "strokeOpacity": 0
          },
          "children": []
        },
        "expected": {
          "html": "<path stroke-opacity=\"0\"></path>"
        }
      },
      {
        "description": "should serialize other attributes",
        "tree": {
          "type": "element",
          "tagName": "svg",
          "properties": {
            "viewBox": "0 0 10 10"
          },
          "children": []
        },
        "expected": {
          "html": "<svg viewBox=\"0 0 10 10\"></svg>"
        }
      },
      {
        "description": "should serialize other falsey attributes",
        "tree": {
          "type": "element",
          "tagName": "svg",
          "properties": {
            "viewBox": ""
          },
          "children": []
        },
        "expected": {
          "html": "<svg viewBox=\"\"></svg>"
        }
      },
      {
        "description": "should serialize other non-string attributes",
        "tree": {
          "type": "element",
          "tagName": "i",
          "properties": {
            "id": true
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<i id>bravo</i>"
        }
      },
      {
        "description": "should encode entities in attribute names",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "3<5\u0000": "alpha"
          },
          "children": []
        },
        "expected": {
          "html": "<circle 3&#x3C;5&#x0;=\"alpha\"></circle>"
        }
      },
      {
        "description": "should encode entities in attribute values",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "title": "3<5\u0000"
          },
          "children": []
        },
        "expected": {
          "html": "<circle title=\"3<5&#x0;\"></circle>"
        }
      },
      {
        "description": "should serialize an SVG tree",
        "tree": {
          "type": "element",
          "tagName": "svg",
          "properties": {
            "xlmns": "http://www.w3.org/2000/svg",
            "xmlnsXLink": "http://www.w3.org/1999/xlink",
            "width": 500,
            "height": 500,
            "viewBox": [0, 0, 500, 500]
          },
          "children": [
            {
              "type": "element",
              "tagName": "title",
              "properties": {},
              "children": [
                {
                  "type": "text",
                  "value": "SVG `<circle>` element"
                }
              ]
            },
            {
              "type": "element",
              "tagName": "circle",
              "properties": {
                "cx": 120,
                "cy": 120,
                "r": 100
              },
              "children": []
            }
          ]
        },
        "expected": {
          "html": "<svg xlmns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"500\" height=\"500\" viewBox=\"0 0 500 500\"><title>SVG `&#x3C;circle>` element</title><circle cx=\"120\" cy=\"120\" r=\"100\"></circle></svg>"
        }
      }
    ]
  },
  {
