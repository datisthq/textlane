  {
    "description": "hast-util-to-html svg {\"preferUnquoted\":true,\"closeEmptyElements\":true,\"tightSelfClosing\":true}",
    "source": {
      "repository": "https://github.com/syntax-tree/hast-util-to-html",
      "commit": "d115f5beab200c819699e1db9d7eb7b5b1009a21",
      "path": "test/svg.js",
      "license": "MIT"
    },
    "pipeline": [
      [
        "html.stringify",
        {
          "preferUnquoted": true,
          "closeEmptyElements": true,
          "tightSelfClosing": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should serialize empties with `/` in `closeEmptyElements` and `tightSelfClosing` mode, *with* a space after an unquoted attribute",
        "tree": {
          "type": "element",
          "tagName": "svg",
          "properties": {
            "viewBox": "0 0 4 4"
          },
          "children": [
            {
              "type": "element",
              "tagName": "circle",
              "properties": {
                "cx": 2,
                "cy": 2,
                "r": 1
              },
              "children": []
            }
          ]
        },
        "expected": {
          "html": "<svg viewBox=\"0 0 4 4\"><circle cx=2 cy=2 r=1 /></svg>"
        }
      }
    ]
  },
  {
    "description": "hast-util-to-html svg",
    "source": {
      "repository": "https://github.com/syntax-tree/hast-util-to-html",
      "commit": "d115f5beab200c819699e1db9d7eb7b5b1009a21",
      "path": "test/svg.js",
      "license": "MIT"
    },
    "pipeline": [["html.stringify"]],
    "tests": [
      {
        "description": "should serialize properties",
        "tree": {
          "type": "element",
          "tagName": "text",
          "properties": {
            "dataFoo": "alpha"
          },
          "children": [
            {
              "type": "text",
              "value": "bravo"
            }
          ]
        },
        "expected": {
          "html": "<text data-foo=\"alpha\">bravo</text>"
        }
      },
      {
        "description": "should ignore attributes set to `null`",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "id": null
          },
          "children": []
        },
        "expected": {
          "html": "<circle></circle>"
        }
      },
      {
        "description": "should ignore attributes set to `undefined`",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {},
          "children": []
        },
        "expected": {
          "html": "<circle></circle>"
        }
      },
      {
        "description": "should serialize SVG props on an `svg` element in HTML",
        "tree": {
          "type": "element",
          "tagName": "div",
          "properties": {},
          "children": [
            {
              "type": "element",
              "tagName": "svg",
              "properties": {
                "xlmns": "http://www.w3.org/2000/svg",
                "strokeLineCap": "round",
                "strokeLineJoin": "round",
                "viewBox": [0, 0, 8, 8]
              },
              "children": [
                {
                  "type": "element",
                  "tagName": "path",
                  "properties": {
                    "stroke": "blue",
                    "d": "M0 6V3h1l1 1v2"
                  },
                  "children": []
                }
              ]
            }
          ]
        },
        "expected": {
          "html": "<div><svg xlmns=\"http://www.w3.org/2000/svg\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 8 8\"><path stroke=\"blue\" d=\"M0 6V3h1l1 1v2\"></path></svg></div>"
        }
      },
      {
        "description": "should serialize an HTML tree with embedded HTML",
        "tree": {
          "type": "root",
          "children": [
            {
              "type": "doctype"
            },
            {
              "type": "element",
              "tagName": "head",
              "properties": {},
              "children": [
                {
                  "type": "element",
                  "tagName": "title",
                  "properties": {},
                  "children": [
                    {
                      "type": "text",
                      "value": "The SVG `<circle>` element"
                    }
                  ]
                }
              ]
            },
            {
              "type": "element",
              "tagName": "body",
              "properties": {},
              "children": [
                {
                  "type": "element",
                  "tagName": "svg",
                  "properties": {
                    "xlmns": "http://www.w3.org/2000/svg",
                    "viewBox": [0, 0, 500, 500]
                  },
                  "children": [
                    {
                      "type": "element",
                      "tagName": "circle",
                      "properties": {
                        "cx": 120,
                        "cy": 120,
                        "r": 100
                      },
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        "expected": {
          "html": "<!doctype html><head><title>The SVG `&#x3C;circle>` element</title></head><body><svg xlmns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 500\"><circle cx=\"120\" cy=\"120\" r=\"100\"></circle></svg></body>"
        }
      }
    ]
  },
