        {
          "space": "svg",
          "quote": "\"",
          "quoteSmart": true
        }
      ]
    ],
    "tests": [
      {
        "description": "should quote smartly if the other quote is less prominent (#1)",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "title": "\"some ' stuff\""
          },
          "children": []
        },
        "expected": {
          "html": "<circle title='&#x22;some &#x27; stuff&#x22;'></circle>"
        }
      },
      {
        "description": "should quote smartly if the other quote is less prominent (#2)",
        "tree": {
          "type": "element",
          "tagName": "circle",
          "properties": {
            "title": "'some \" stuff'"
          },
          "children": []
        },
        "expected": {
          "html": "<circle title=\"&#x27;some &#x22; stuff&#x27;\"></circle>"
        }
      }
    ]
  },
