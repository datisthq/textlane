[
  {
    "description": "retext-sentence-spacing {\"preferred\":1}",
    "source": {
      "repository": "https://github.com/retextjs/retext-sentence-spacing",
      "commit": "63807dc0c23cc1e303ac891a3a450d3809c81bc9",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [
      ["nl.parse"],
      [
        "nl.sentenceSpacing",
        {
          "preferred": 1
        }
      ],
      ["nl.stringify"]
    ],
    "tests": [
      {
        "description": "should emit a message w/ metadata",
        "input": "One sentence. Two sentences.\n\nOne sentence.  Two sentences.\n\nOne sentence.\nTwo sentences.",
        "expected": {
          "messages": [
            {
              "ruleId": "space",
              "source": "retext-sentence-spacing",
              "place": {
                "start": {
                  "line": 3,
                  "column": 14,
                  "offset": 43
                },
                "end": {
                  "line": 3,
                  "column": 16,
                  "offset": 45
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "description": "retext-sentence-spacing",
    "source": {
      "repository": "https://github.com/retextjs/retext-sentence-spacing",
      "commit": "63807dc0c23cc1e303ac891a3a450d3809c81bc9",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [["nl.parse"], ["nl.sentenceSpacing"], ["nl.stringify"]],
    "tests": [
      {
        "description": "should catch more than two spaces",
        "input": "One sentence.   Three sentences.",
        "expected": {
          "messages": [
            {
              "ruleId": "space",
              "source": "retext-sentence-spacing",
              "place": {
                "start": {
                  "line": 1,
                  "column": 14,
                  "offset": 13
                },
                "end": {
                  "line": 1,
                  "column": 17,
                  "offset": 16
                }
              }
            }
          ]
        }
      },
      {
        "description": "should not emit messages for non-space whitespace",
        "input": "One sentence.\tFour sentences.",
        "expected": {
          "messages": []
        }
      }
    ]
  }
]
