[
  {
    "description": "retext-smartypants",
    "source": {
      "repository": "https://github.com/retextjs/retext-smartypants",
      "commit": "0ffca5eeb04b3d163624aad28ef36911edd224d7",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [["nl.parse"], ["nl.smartypants"], ["nl.stringify"]],
    "tests": [
      {
        "description": "should curl double quotes",
        "input": "Alfred \"bertrand\" cees.",
        "expected": {
          "txt": "Alfred “bertrand” cees."
        }
      },
      {
        "description": "should curl single quotes",
        "input": "Alfred 'bertrand' cees.",
        "expected": {
          "txt": "Alfred ‘bertrand’ cees."
        }
      },
      {
        "description": "should curl initial double quotes",
        "input": "\"Alfred\" bertrand.",
        "expected": {
          "txt": "“Alfred” bertrand."
        }
      },
      {
        "description": "should curl initial single quotes",
        "input": "'Alfred' bertrand.",
        "expected": {
          "txt": "‘Alfred’ bertrand."
        }
      },
      {
        "description": "should curl final double quotes",
        "input": "Alfred \"bertrand\".",
        "expected": {
          "txt": "Alfred “bertrand”."
        }
      },
      {
        "description": "should curl final single quotes",
        "input": "Alfred 'bertrand'.",
        "expected": {
          "txt": "Alfred ‘bertrand’."
        }
      },
      {
        "description": "should curl single quotes in double quotes",
        "input": "\"'Alfred' bertrand\" cees.",
        "expected": {
          "txt": "“‘Alfred’ bertrand” cees."
        }
      },
      {
        "description": "should curl single quotes in double quotes (2)",
        "input": "\"Alfred 'bertrand'\" cees.",
        "expected": {
          "txt": "“Alfred ‘bertrand’” cees."
        }
      },
      {
        "description": "should curl double quotes in single quotes",
        "input": "'\"Alfred\" bertrand' cees.",
        "expected": {
          "txt": "‘“Alfred” bertrand’ cees."
        }
      },
      {
        "description": "should curl double quotes in single quotes (2)",
        "input": "'Alfred \"bertrand\"' cees.",
        "expected": {
          "txt": "‘Alfred “bertrand”’ cees."
        }
      },
      {
        "description": "should curl nested double quotes",
        "input": "\"Alfred \"bertrand\" cees.\"",
        "expected": {
          "txt": "“Alfred “bertrand” cees.”"
        }
      },
      {
        "description": "should curl nested single quotes",
        "input": "'Alfred 'bertrand' cees.'",
        "expected": {
          "txt": "‘Alfred ‘bertrand’ cees.’"
        }
      },
      {
        "description": "should curl initial double quotes when followed by a full stop",
        "input": "Alfred \".bertrand\" cees.",
        "expected": {
          "txt": "Alfred “.bertrand” cees."
        }
      },
      {
        "description": "should curl initial single quotes when followed by a full stop",
        "input": "Alfred '.bertrand' cees.",
        "expected": {
          "txt": "Alfred ‘.bertrand’ cees."
        }
      },
      {
        "description": "should curl initial double quotes when preceded by a full stop",
        "input": "Alfred \"bertrand.\" cees.",
        "expected": {
          "txt": "Alfred “bertrand.” cees."
        }
      },
      {
        "description": "should curl initial single quotes when preceded by a full stop",
        "input": "Alfred 'bertrand.' cees.",
        "expected": {
          "txt": "Alfred ‘bertrand.’ cees."
        }
      },
      {
        "description": "should curl initial double quotes when followed by a multiple full-stops",
        "input": "\"..Alfred\"",
        "expected": {
          "txt": "“..Alfred”"
        }
      },
      {
        "description": "should curl initial single quotes when followed by a multiple full-stops",
        "input": "'..Alfred'",
        "expected": {
          "txt": "‘..Alfred’"
        }
      },
      {
        "description": "should curl final double quotes when followed by a multiple full-stops",
        "input": "\"Alfred\"..",
        "expected": {
          "txt": "“Alfred”.."
        }
      },
      {
        "description": "should curl final single quotes when followed by a multiple full-stops",
        "input": "'Alfred'..",
        "expected": {
          "txt": "‘Alfred’.."
        }
      },
      {
        "description": "should curl final double quotes when followed by a comma",
        "input": "\"Alfred\", bertrand.",
        "expected": {
          "txt": "“Alfred”, bertrand."
        }
      },
      {
        "description": "should curl final single quotes when followed by a comma",
        "input": "'Alfred', bertrand.",
        "expected": {
          "txt": "‘Alfred’, bertrand."
        }
      },
      {
        "description": "should curl apostrophes when followed `s`",
        "input": "Alfred's bertrand.",
        "expected": {
          "txt": "Alfred’s bertrand."
        }
      },
      {
        "description": "should curl apostrophes when followed by a decade (`80s`)",
        "input": "In the '90s.",
        "expected": {
          "txt": "In the ’90s."
        }
      },
      {
        "description": "should curl final double quotes when followed by a full stop",
        "input": "\"Alfred bertrand\". Cees.",
        "expected": {
          "txt": "“Alfred bertrand”. Cees."
        }
      },
      {
        "description": "should curl final single quotes when followed by a full stop",
        "input": "'Alfred bertrand'. Cees.",
        "expected": {
          "txt": "‘Alfred bertrand’. Cees."
        }
      },
      {
        "description": "should use correct quotes around work breaks",
        "input": "(\"A.\")",
        "expected": {
          "txt": "(“A.”)"
        }
      },
      {
        "description": "should use correct quotes around work breaks #1",
        "input": "\"~a",
        "expected": {
          "txt": "“~a"
        }
      },
      {
        "description": "should use correct quotes around work breaks #2",
        "input": "\"~*",
        "expected": {
          "txt": "”~*"
        }
      },
      {
        "description": "should use correct quotes around work breaks #3",
        "input": "\"~",
        "expected": {
          "txt": "”~"
        }
      },
      {
        "description": "should replace two dashes with an em-dash",
        "input": "Alfred--bertrand--cees.",
        "expected": {
          "txt": "Alfred—bertrand—cees."
        }
      },
      {
        "description": "should replace three full stops",
        "input": "Alfred... Bertrand.",
        "expected": {
          "txt": "Alfred… Bertrand."
        }
      },
      {
        "description": "should replace three initial full stops",
        "input": "...Alfred Bertrand.",
        "expected": {
          "txt": "…Alfred Bertrand."
        }
      },
      {
        "description": "should replace three final full stops",
        "input": "Alfred Bertrand...",
        "expected": {
          "txt": "Alfred Bertrand…"
        }
      },
      {
        "description": "should replace three padded full stops",
        "input": "Alfred ... Bertrand.",
        "expected": {
          "txt": "Alfred … Bertrand."
        }
      },
      {
        "description": "should replace three padded initial full stops",
        "input": "... Alfred Bertrand.",
        "expected": {
          "txt": "… Alfred Bertrand."
        }
      },
      {
        "description": "should replace three padded final full stops",
        "input": "Alfred Bertrand ...",
        "expected": {
          "txt": "Alfred Bertrand …"
        }
      },
      {
        "description": "should replace three padded full stops with spaces",
        "input": "Alfred . . . Bertrand.",
        "expected": {
          "txt": "Alfred … Bertrand."
        }
      },
      {
        "description": "should replace three padded initial full stops with spaces",
        "input": ". . . Alfred Bertrand.",
        "expected": {
          "txt": "… Alfred Bertrand."
        }
      },
      {
        "description": "should replace three padded final full stops with spaces",
        "input": "Alfred Bertrand . . .",
        "expected": {
          "txt": "Alfred Bertrand …"
        }
      },
      {
        "description": "should replace three full stops with spaces",
        "input": "Alfred. . . Bertrand.",
        "expected": {
          "txt": "Alfred… Bertrand."
        }
      },
      {
        "description": "should replace three initial full stops with spaces",
        "input": ". . .Alfred Bertrand.",
        "expected": {
          "txt": "…Alfred Bertrand."
        }
      },
      {
        "description": "should replace three final full stops with spaces",
        "input": "Alfred Bertrand. . .",
        "expected": {
          "txt": "Alfred Bertrand…"
        }
      },
      {
        "description": "should replace more than three full stops",
        "input": "Alfred..... Bertrand.",
        "expected": {
          "txt": "Alfred… Bertrand."
        }
      },
      {
        "description": "should replace more than three full stops (2)",
        "input": "Alfred bertrand....",
        "expected": {
          "txt": "Alfred bertrand…"
        }
      },
      {
        "description": "should replace more than three full stops (3)",
        "input": "......Alfred bertrand.",
        "expected": {
          "txt": "…Alfred bertrand."
        }
      },
      {
        "description": "should replace more than three full stops with funky spacing",
        "input": "Alfred .. .. . Bertrand.",
        "expected": {
          "txt": "Alfred … Bertrand."
        }
      },
      {
        "description": "should NOT replace less than three full stops",
        "input": "Alfred.. Bertrand.",
        "expected": {
          "txt": "Alfred.. Bertrand."
        }
      },
      {
        "description": "should NOT replace less than three full stops (2)",
        "input": "Alfred bertrand. .",
        "expected": {
          "txt": "Alfred bertrand. ."
        }
      },
      {
        "description": "should NOT replace less than three full stops (3)",
        "input": ".Alfred bertrand.",
        "expected": {
          "txt": ".Alfred bertrand."
        }
      }
    ]
  },
  {
    "description": "retext-smartypants {\"closingQuotes\":{\"double\":\"»\",\"single\":\"›\"},\"openingQuotes\":{\"double\":\"«\",\"single\":\"‹\"}}",
    "source": {
      "repository": "https://github.com/retextjs/retext-smartypants",
      "commit": "0ffca5eeb04b3d163624aad28ef36911edd224d7",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [
      ["nl.parse"],
      [
        "nl.smartypants",
        {
          "closingQuotes": {
            "double": "»",
            "single": "›"
          },
          "openingQuotes": {
            "double": "«",
            "single": "‹"
          }
        }
      ],
      ["nl.stringify"]
    ],
    "tests": [
      {
        "description": "should use quotes from options",
        "input": "Alfred \"bertrand\" 'cees'.",
        "expected": {
          "txt": "Alfred «bertrand» ‹cees›."
        }
      }
    ]
  },
  {
    "description": "retext-smartypants {\"dashes\":\"oldschool\"}",
    "source": {
      "repository": "https://github.com/retextjs/retext-smartypants",
      "commit": "0ffca5eeb04b3d163624aad28ef36911edd224d7",
      "path": "test.js",
      "license": "MIT"
    },
    "pipeline": [
