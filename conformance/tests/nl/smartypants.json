        {
          "dashes": "oldschool"
        }
      ],
      ["nl.stringify"]
    ],
    "tests": [
      {
        "description": "should replace two dashes with an en-dash, three dashes with an em-dash",
        "input": "Alfred--bertrand---cees.",
        "expected": {
          "txt": "Alfred–bertrand—cees."
        }
      },
      {
        "description": "should turn an en dash + dash into an em-dash",
        "input": "Alfred–-",
        "expected": {
          "txt": "Alfred—"
        }
      }
    ]
  },
